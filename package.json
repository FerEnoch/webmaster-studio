{
  "name": "estudio",
  "private": true,
  "version": "0.1.0",
  "description": "Monorepo de webs por rubro: 9 apps Next.js de referencia + 8 apps Astro (7 demos de rubro + portfolio madre).",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "dev": "pnpm --filter thaloz run dev",
    "dev:thaloz": "pnpm --filter thaloz run dev",
    "dev:invgate": "pnpm --filter invgate run dev",
    "build": "pnpm -r run build",
    "build:thaloz": "pnpm --filter thaloz run build",
    "build:invgate": "pnpm --filter invgate run build",
    "dev:constructora": "pnpm --filter constructora run dev",
    "build:constructora": "pnpm --filter constructora run build",
    "dev:inmobiliaria": "pnpm --filter inmobiliaria run dev",
    "build:inmobiliaria": "pnpm --filter inmobiliaria run build",
    "dev:salud": "pnpm --filter salud run dev",
    "build:salud": "pnpm --filter salud run build",
    "dev:autos": "pnpm --filter autos run dev",
    "build:autos": "pnpm --filter autos run build",
    "dev:fitness": "pnpm --filter fitness run dev",
    "build:fitness": "pnpm --filter fitness run build",
    "dev:veterinaria": "pnpm --filter veterinaria run dev",
    "build:veterinaria": "pnpm --filter veterinaria run build",
    "dev:vinos": "pnpm --filter vinos run dev",
    "build:vinos": "pnpm --filter vinos run build",
    "audit": "pnpm audit",
    "audit:high": "pnpm audit --audit-level high",
    "outdated": "pnpm outdated",
    "check-deps": "pnpm audit --audit-level high && pnpm outdated",
    "install:frozen": "pnpm install --frozen-lockfile"
  }
}

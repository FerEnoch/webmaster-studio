---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import AutoCard from "../components/AutoCard.astro";
import { concesionario, nuevos } from "../content/concesionario";
---

<Base content={concesionario} title={`Nuevos · ${concesionario.brand}`}>
  <PageHead
    kicker="Cero kilómetros"
    title="Nuevos, listos para entrega"
    subtitle="Unidades 0 km con documentación, patentaria gestionada y service de cortesía. Sin recargos de flete ni de gestoría: el precio del aviso es el precio del acta."
  />

  <section class="wm-container pb-16 sm:pb-24">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {nuevos.map((auto) => <AutoCard auto={auto} href={`/nuevos/${auto.id}`} />)}
    </div>
  </section>

  <section class="wm-container pb-16 sm:pb-24">
    <div class="grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:items-center">
      <div class="rounded-wm-lg border border-line p-8 sm:p-12">
        <p class="wm-kicker">Cómo es la entrega</p>
        <h2 class="wm-display mt-5 text-[clamp(1.8rem,4.5vw,2.8rem)]">
          Del showroom a tu garage, en el día
        </h2>
        <ol class="mt-8 space-y-5">
          {
            [
              [
                "Elegís la unidad",
                "Probala en el circuito de la casa o en la ruta que elijas.",
              ],
              [
                "Resolvemos la financiación",
                "Crédito prendario, plan de pago directo o parte de pago: lo que te cierre.",
              ],
              [
                "Firmamos y te la llevamos",
                "Transferencia en el acto, patentaria gestionada y service de cortesía.",
              ],
            ].map(([titulo, texto], i) => (
              <li class="flex gap-5">
                <span class="wm-display text-3xl leading-none text-accent">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span>
                  <span class="block font-semibold">{titulo}</span>
                  <span class="mt-1 block text-sm text-muted">{texto}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <a href="/#testdrive" class="wm-btn mt-8">Agendar un test drive</a>
      </div>

      <aside class="wm-card">
        <p class="wm-kicker">Stock de nuevos</p>
        <p class="mt-4 text-sm text-muted">
          {nuevos.length} unidades 0 km publicadas. Actualizado hace 2 min. La
          entrega se coordina en la sucursal de cada unidad.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-muted">
          {
            nuevos.map((auto) => (
              <li class="flex items-baseline justify-between gap-4 border-b border-line pb-2">
                <span>
                  {auto.marca} {auto.modelo}
                </span>
                <span class="font-semibold text-accent">{auto.sucursal}</span>
              </li>
            ))
          }
        </ul>
        <a href="/contacto" class="wm-btn mt-6 w-full">Consultar por un 0 km</a>
      </aside>
    </div>
  </section>
</Base>

---
import Base from "../../layouts/Base.astro";
import AutoSheet from "../../components/AutoSheet.astro";
import { ars, concesionario, nuevos, type Auto } from "../../content/concesionario";

export function getStaticPaths() {
  return nuevos.map((auto) => ({
    params: { id: auto.id },
    props: { auto },
  }));
}

interface Props {
  auto: Auto;
}

const { auto } = Astro.props;

const otros = nuevos.filter((a) => a.id !== auto.id).slice(0, 3);
---

<Base
  content={concesionario}
  title={`${auto.marca} ${auto.modelo} ${auto.anio} 0 km · Nuevos · ${concesionario.brand}`}
  description={`${auto.marca} ${auto.modelo} ${auto.version} 0 km, ${auto.combustible}, ${auto.caja}, entrega en ${auto.sucursal}. Precio final ${ars(auto.precio)} con IVA incluido. Agendá tu test drive.`}
>
  <AutoSheet auto={auto} otros={otros} kind="nuevos" />
</Base>

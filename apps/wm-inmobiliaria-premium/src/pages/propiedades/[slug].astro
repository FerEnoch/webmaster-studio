---
import type { GetStaticPaths } from "astro";
import Base from "../../layouts/Base.astro";
import DetailGallery from "../../components/DetailGallery";
import FavoriteButton from "../../components/FavoriteButton";
import RoomTour from "../../components/RoomTour";
import Simulators from "../../components/Simulators";
import SolarLot from "../../components/SolarLot";
import { roomsFor, solarFor } from "../../lib/experiences";
import { formatPrice, properties, type Property } from "../../lib/properties";
import { appUrl } from "../../lib/urls";
import { propertyHref } from "../../lib/paths";

export const getStaticPaths = (() => properties.map((property) => ({ params: { slug: property.slug }, props: { property } }))) satisfies GetStaticPaths;
const { property } = Astro.props as { property: Property };
const others = properties.filter((item) => item.slug !== property.slug).slice(0, 3);
const rooms = roomsFor(property.slug);
const solar = solarFor(property.slug);
const galleryImages = rooms
  ? rooms.map((room) => ({ imagen: room.imagen, alt: room.alt, titulo: room.nombre }))
  : [{ imagen: property.cover, alt: property.coverAlt, titulo: property.title }];
const experienceLabel = rooms ? "Recorrido" : solar ? "Lote solar" : "Detalle";
---
<Base title={`${property.title} — Estudio Real State`} description={property.blurb}>
  <article class="px-4 pt-28 pb-24 sm:px-8">
    <div class="mx-auto max-w-[1400px]">
      <nav aria-label="Migas de pan" class="mb-6 flex items-center gap-2 text-xs tracking-[0.12em] text-ink/50 uppercase">
        <a href={appUrl("/propiedades")} class="hover:text-brass">Propiedades</a><span aria-hidden="true">/</span><span>{property.barrio}</span>
      </nav>
      <div class="grid items-end gap-6 lg:grid-cols-[1fr_auto]">
        <div>
          <p class="text-xs tracking-[0.22em] text-brass uppercase">{property.op} · {property.type}</p>
          <h1 class="mt-3 max-w-4xl font-serif text-[clamp(3rem,6vw,6.5rem)] leading-[0.9]">{property.title}</h1>
          <p class="mt-4 text-lg text-ink/60">{property.barrio}, {property.ciudad}</p>
        </div>
        <p class="font-serif text-3xl lg:pb-2 lg:text-4xl">{formatPrice(property)}</p>
      </div>

      <nav aria-label="Secciones de la ficha" class="sticky top-20 z-30 mt-8 flex gap-1 overflow-x-auto rounded-2xl bg-ivory/90 p-1.5 whitespace-nowrap backdrop-blur-xl sm:top-24 sm:gap-2" data-detail-nav>
        <a href="#ficha" class="inline-flex min-h-11 items-center rounded-full px-2.5 text-sm hover:bg-sand sm:px-4">Ficha</a>
        <a href="#galeria" class="inline-flex min-h-11 items-center rounded-full px-2.5 text-sm hover:bg-sand sm:px-4">Galería</a>
        <a href="#experiencia" class="inline-flex min-h-11 items-center rounded-full px-2.5 text-sm hover:bg-sand sm:px-4">{experienceLabel}</a>
        {rooms && solar && <a href="#terreno" class="inline-flex min-h-11 items-center rounded-full px-2.5 text-sm hover:bg-sand sm:px-4">Terreno</a>}
        <a href="#simuladores" class="inline-flex min-h-11 items-center rounded-full px-2.5 text-sm hover:bg-sand sm:px-4">Simuladores</a>
        <a href="#seguir-explorando" class="inline-flex min-h-11 items-center rounded-full px-2.5 text-sm hover:bg-sand sm:px-4">Similares</a>
        <span class="ml-auto hidden items-center px-3 text-xs text-ink/50 lg:flex">{property.barrio} · {property.m2.toLocaleString("es-AR")} m²</span>
      </nav>

      <section id="galeria" aria-label="Galería de fotos" class="mt-9 scroll-mt-40 sm:scroll-mt-44">
        <DetailGallery images={galleryImages} propertyTitle={property.title} client:load />
        <div class="relative mt-3 hidden aspect-[4/3] overflow-hidden rounded-[28px] bg-sand sm:aspect-[16/9] lg:aspect-[2/1]">
          <FavoriteButton slug={property.slug} title={property.title} className="absolute top-4 right-4" client:load />
        </div>
      </section>

      <div id="ficha" class="mt-10 grid scroll-mt-40 gap-10 sm:scroll-mt-44 lg:grid-cols-[1.25fr_.75fr]">
        <section aria-labelledby="descripcion">
          <h2 id="descripcion" class="font-serif text-4xl">Una forma distinta de <span class="italic">habitar.</span></h2>
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink/70">{property.blurb}</p>
          <ul class="mt-7 grid gap-3 sm:grid-cols-2">
            {property.features.map((feature) => <li class="flex items-center gap-3 border-b border-ink/10 pb-3 text-sm text-ink/75"><span aria-hidden="true" class="text-brass">✦</span>{feature}</li>)}
          </ul>
          <div class="mt-6 flex flex-wrap gap-2">
            <FavoriteButton slug={property.slug} title={property.title} client:load />
            <span class="inline-flex items-center rounded-full bg-sand px-4 py-2 text-xs text-ink/60">Guardado solo en este navegador</span>
          </div>
        </section>
        <aside class="h-fit rounded-[28px] bg-sand p-6 sm:p-8" aria-label="Datos principales">
          <p class="text-xs tracking-[0.2em] text-ink/45 uppercase">Ficha de la propiedad</p>
          <p class="mt-2 font-serif text-2xl" data-facts-price>{formatPrice(property)}</p>
          <dl class="mt-5 space-y-4 text-sm" data-facts-list>
            <div class="flex justify-between gap-4 border-b border-ink/10 pb-3"><dt class="text-ink/50">Superficie</dt><dd class="font-medium" data-facts-m2>{property.m2.toLocaleString("es-AR")} m²</dd></div>
            {property.m2Lote && <div class="flex justify-between gap-4 border-b border-ink/10 pb-3"><dt class="text-ink/50">Lote</dt><dd class="font-medium">{property.m2Lote.toLocaleString("es-AR")} m²</dd></div>}
            {property.amb && <div class="flex justify-between gap-4 border-b border-ink/10 pb-3"><dt class="text-ink/50">Ambientes</dt><dd class="font-medium">{property.amb}</dd></div>}
            {property.dorm && <div class="flex justify-between gap-4 border-b border-ink/10 pb-3"><dt class="text-ink/50">Dormitorios</dt><dd class="font-medium">{property.dorm}</dd></div>}
            {property.banos && <div class="flex justify-between gap-4 border-b border-ink/10 pb-3"><dt class="text-ink/50">Baños</dt><dd class="font-medium">{property.banos}</dd></div>}
            {property.cochera != null && <div class="flex justify-between gap-4 border-b border-ink/10 pb-3"><dt class="text-ink/50">Cocheras</dt><dd class="font-medium">{property.cochera}</dd></div>}
            {property.expensas != null && <div class="flex justify-between gap-4 border-b border-ink/10 pb-3"><dt class="text-ink/50">Expensas</dt><dd class="font-medium">$ {property.expensas.toLocaleString("es-AR")}</dd></div>}
            {property.antiguedad && <div class="flex justify-between gap-4 border-b border-ink/10 pb-3"><dt class="text-ink/50">Antigüedad</dt><dd class="font-medium">{property.antiguedad}</dd></div>}
          </dl>
          <p class="mt-5 text-xs leading-relaxed text-ink/50">Propiedad ficticia para una demo. No hay consultas, reservas ni envío de datos.</p>
        </aside>
      </div>

      <div id="experiencia" class="mt-16 scroll-mt-40 sm:scroll-mt-44">
        {rooms && (
          <section aria-labelledby="recorrido-titulo">
            <p class="text-xs tracking-[0.25em] text-brass uppercase">Visita en fotos</p>
            <h2 id="recorrido-titulo" class="mt-2 mb-6 max-w-3xl font-serif text-[clamp(2.2rem,4vw,3.8rem)] leading-[0.95]">Caminá la casa <span class="italic">antes de visitarla.</span></h2>
            <RoomTour rooms={rooms} propertyTitle={property.title} client:load />
          </section>
        )}
        {solar && (
          <section id="terreno" aria-labelledby="terreno-titulo" class:list={["scroll-mt-40 sm:scroll-mt-44", rooms && "mt-16 sm:mt-24"]}>
            <p class="text-xs tracking-[0.25em] text-brass uppercase">Terreno y orientación</p>
            <h2 id="terreno-titulo" class="mt-2 mb-6 max-w-3xl font-serif text-[clamp(2.2rem,4vw,3.8rem)] leading-[0.95]">Mirá dónde da <span class="italic">el sol.</span></h2>
            <SolarLot lot={solar} propertyTitle={property.title} client:load />
          </section>
        )}
      </div>

      <section id="simuladores" aria-label="Simuladores locales" class="mt-16 scroll-mt-40 sm:scroll-mt-44">
        <p class="text-xs tracking-[0.25em] text-brass uppercase">Números con contexto</p>
        <h2 class="mt-2 mb-6 max-w-3xl font-serif text-[clamp(2.2rem,4vw,3.8rem)] leading-[0.95]">Probá los números <span class="italic">sin dejar datos.</span></h2>
        <Simulators property={property} client:load />
        <p class="mt-3 text-xs text-ink/50">Valores sintéticos de demo. Esta página no hace red ni guarda lo que escribís.</p>
      </section>
      <section class="mt-20 border-t border-ink/15 pt-12" aria-labelledby="seguir-explorando">
        <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
          <h2 id="seguir-explorando" class="scroll-mt-40 font-serif text-4xl sm:scroll-mt-44 sm:text-5xl">Seguir <span class="italic">explorando</span></h2>
          <a href={appUrl("/propiedades")} class="button-ink w-fit">Ver las ocho propiedades →</a>
        </div>
        <ul class="mt-7 grid gap-4 sm:grid-cols-3">
          {others.map((item) => <li><a href={propertyHref(item.slug)} class="flex items-center justify-between rounded-2xl bg-sand px-5 py-4 hover:bg-ink hover:text-ivory"><span><span class="block font-serif text-xl">{item.title}</span><span class="text-xs opacity-60">{item.barrio}</span></span><span aria-hidden="true">→</span></a></li>)}
        </ul>
      </section>
    </div>
  </article>
</Base>

---
import Base from "../../layouts/Base.astro";
import CartToast from "../../components/CartToast.astro";
import StorePhoto from "../../components/StorePhoto.astro";
import { productPhoto } from "@lib/photos";
import { appUrl } from "@lib/urls";
import { PRODUCTS, formatPrice, productById } from "@lib/shop";

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { id: p.id } }));
}

const nav = [
  { label: "Inicio", href: "/" },
  { label: "Catálogo", href: "/catalogo" },
  { label: "Envíos", href: "/envios" },
  { label: "Guía de talles", href: "/guia-de-talles" },
  { label: "Contacto", href: "/contacto" },
];

const product = productById(Astro.params.id ?? "");
if (!product) throw new Error(`Prenda desconocida: "${Astro.params.id}"`);
const relacionados = PRODUCTS.filter((p) => p.id !== product.id).slice(0, 3);
---

<Base
  title={`${product.nombre} · Trama`}
  description={`${product.nombre}: ${product.descripcion}`}
  nav={nav}
>
  <div class="wm-container">
    <p style="padding-top:1.5rem"><a style="color:var(--wm-accent);font-weight:700" href={appUrl("/catalogo")}>← Volver al catálogo</a></p>
    <div class="wm-detail">
      <figure style="margin:0">
        <StorePhoto photo={productPhoto(product)} placement="detail" priority />
        <figcaption class="wm-muted photo-note">Foto ilustrativa. La imagen no cambia al elegir otro color.</figcaption>
      </figure>
      <div>
        <p class="wm-kicker">{product.categoria}</p>
        <h1 class="wm-display" style="font-size:clamp(2.2rem,5vw,3.4rem);margin:.5rem 0">{product.nombre}</h1>
        <p class="wm-price" style="font-size:1.4rem">{formatPrice(product.precio)}</p>
        <p class="wm-muted">Precio final, IVA incluido.</p>
        <p>{product.descripcion}</p>
        <ul>{product.detalles.map((d) => (<li>{d}</li>))}</ul>

        <form id="agregar" data-producto={product.id} aria-label="Agregar al carrito">
          <p><strong>Color</strong></p>
          <div style="display:flex;gap:.5rem;flex-wrap:wrap" role="radiogroup" aria-label="Color">
            {product.colores.map((c, i) => (
              <label style="display:inline-flex;align-items:center;gap:.4rem;border:1px solid var(--wm-line);border-radius:.5rem;padding:.35rem .8rem .35rem .4rem;cursor:pointer">
                <input type="radio" name="color" value={c.id} checked={i === 0} />
                <span class="wm-dot" style={`background:${c.hex}`} aria-hidden="true"></span> {c.nombre}
              </label>
            ))}
          </div>
          <p style="margin-top:1rem"><strong>Talle</strong> · <a style="color:var(--wm-accent);font-weight:700" href={appUrl("/guia-de-talles")}>ver guía</a></p>
          <div style="display:flex;gap:.5rem;flex-wrap:wrap" role="radiogroup" aria-label="Talle">
            {product.talles.map((t, i) => (
              <label style="display:inline-flex;align-items:center;gap:.4rem;border:1px solid var(--wm-line);border-radius:.5rem;padding:.4rem .8rem;cursor:pointer">
                <input type="radio" name="talle" value={t} checked={i === 0} /> {t}
              </label>
            ))}
          </div>
          <p style="margin-top:1rem"><strong>Cantidad</strong></p>
          <div class="wm-qty">
            <button type="button" data-menos aria-label="Quitar uno">−</button>
            <output data-cantidad aria-live="polite">1</output>
            <button type="button" data-mas aria-label="Agregar uno">+</button>
          </div>
          <p role="status" aria-live="polite" data-disponibilidad style="font-weight:700"></p>
          <p style="display:flex;gap:.8rem;flex-wrap:wrap">
            <button class="wm-btn" type="button" data-agregar disabled>Agregar al carrito</button>
            <a class="wm-btn wm-btn--ghost" href={appUrl("/carrito")}>Ver mi carrito</a>
          </p>
          <p role="status" aria-live="polite" data-aviso class="wm-muted"></p>
        </form>
        <CartToast />
      </div>
    </div>

    <section aria-labelledby="rel" style="padding-block:1rem 3rem">
      <h2 id="rel" class="wm-display" style="font-size:1.8rem">Combiná con</h2>
      <div class="wm-grid" style="margin-top:1rem">
        {relacionados.map((r) => (
          <article class="wm-card">
            <StorePhoto photo={productPhoto(r)} />
            <div class="wm-card__body">
              <h3 class="wm-display">{r.nombre}</h3>
              <p>{formatPrice(r.precio)}</p>
              <a class="wm-link" style="color:var(--wm-accent);font-weight:700" href={appUrl(`/producto/${r.id}`)}>Ver y agregar →</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script type="application/json" data-variantes set:html={JSON.stringify(product.stock)} />
  <script>
    import { CART_KEY, addLine, parseCart } from "@lib/shop";
    const form = document.getElementById("agregar");
    const variantSrc = document.querySelector("[data-variantes]");
    if (!(form instanceof HTMLFormElement) || !(variantSrc instanceof HTMLElement)) throw new Error("Formulario no disponible");
    const productId: string = form.dataset.producto || "";
    const variantes: Array<{ color: string; size: string; qty: number }> = JSON.parse(variantSrc.textContent || "[]");
    const out = form.querySelector("[data-disponibilidad]");
    const aviso = form.querySelector("[data-aviso]");
    const cant = form.querySelector("[data-cantidad]");
    const masBtn = form.querySelector("[data-mas]");
    const menosBtn = form.querySelector("[data-menos]");
    const addBtn = form.querySelector("[data-agregar]");
    if (!(out instanceof HTMLElement) || !(aviso instanceof HTMLElement) || !(cant instanceof HTMLElement) || !(masBtn instanceof HTMLButtonElement) || !(menosBtn instanceof HTMLButtonElement) || !(addBtn instanceof HTMLButtonElement)) {
      throw new Error("Formulario incompleto");
    }
    let qty = 1;
    const sel = (): { color: string; size: string } => ({
      color: form.querySelector<HTMLInputElement>('input[name="color"]:checked')?.value || "",
      size: form.querySelector<HTMLInputElement>('input[name="talle"]:checked')?.value || "",
    });
    const readCart = () => {
      try { return parseCart(JSON.parse(localStorage.getItem(CART_KEY) ?? "[]")); }
      catch { return []; }
    };
    const maxFor = () => {
      const found = sel();
      const v = variantes.find((x) => x.color === found.color && x.size === found.size);
      const inCart = readCart().find((line) => line.producto === productId && line.color === found.color && line.size === found.size);
      return Math.max(0, (v?.qty ?? 0) - (inCart?.qty ?? 0));
    };
    const paint = () => {
      const max = maxFor();
      qty = Math.max(1, Math.min(qty, Math.max(max, 1)));
      cant.textContent = max > 0 ? String(qty) : "0";
      addBtn.disabled = max === 0;
      masBtn.disabled = qty >= max;
      menosBtn.disabled = qty <= 1;
      out.textContent = max <= 0
        ? "Agotada en esta variante."
        : max <= 2 ? ("Quedan " + max + " en esta variante.") : (max + " disponibles en esta variante.");
    };
    masBtn.addEventListener("click", () => { qty = Math.min(qty + 1, Math.max(maxFor(), 1)); paint(); });
    menosBtn.addEventListener("click", () => { qty = Math.max(1, qty - 1); paint(); });
    form.addEventListener("change", () => { qty = 1; paint(); });
    addBtn.addEventListener("click", () => {
      if (maxFor() <= 0) return;
      const found = sel();
      try {
        const cart = readCart();
        const next = addLine(cart, { producto: productId, color: found.color, size: found.size, qty });
        localStorage.setItem(CART_KEY, JSON.stringify(next));
        const saved = next.find((l) => l.producto === productId && l.color === found.color && l.size === found.size);
        // El aviso "Agregado a tu carrito" escucha este evento con el detalle de la línea.
        if (saved) window.dispatchEvent(new CustomEvent("trama:cart", { detail: { line: saved } }));
        aviso.textContent = next.length === cart.length && JSON.stringify(next) === JSON.stringify(cart)
          ? "Esa variante no tiene más stock."
          : "Listo: ya está en tu carrito.";
        paint();
      } catch (err) {
        aviso.textContent = "Tu navegador bloqueó el guardado local.";
      }
    });
    window.addEventListener("pageshow", paint);
    window.addEventListener("storage", paint);
    paint();
  </script>
</Base>

<style>
  .photo-note { margin-top: .5rem; font-size: .85rem; }
</style>

---
import Base from "../layouts/Base.astro";
import { appUrl } from "@lib/urls";

const nav = [
  { label: "Inicio", href: "/" },
  { label: "Catálogo", href: "/catalogo" },
  { label: "Envíos", href: "/envios" },
  { label: "Guía de talles", href: "/guia-de-talles" },
  { label: "Contacto", href: "/contacto" },
];
---

<Base
  title="Contacto · Trama"
  description="Dónde está Trama, horarios y cómo consultar por tu pedido."
  nav={nav}
>
  <div class="wm-container" style="padding-block:2rem 3rem;max-width:60rem">
    <p class="wm-kicker">Contacto</p>
    <h1 class="wm-display" style="font-size:clamp(2.2rem,5vw,3.6rem);margin:.6rem 0">Hablamos</h1>
    <ul style="display:grid;gap:.6rem;padding:0;list-style:none">
      <li><strong>Local:</strong> Fitz Roy 1720, Palermo, Buenos Aires.</li>
      <li><strong>Horarios:</strong> lunes a sábado de 10 a 20 h.</li>
      <li><strong>Teléfono:</strong> +54 11 4833-2299.</li>
      <li><strong>Correo:</strong> hola@trama.ejemplo.</li>
    </ul>
    <p style="display:flex;gap:.8rem;flex-wrap:wrap">
      <a class="wm-btn wm-btn--ghost" href={appUrl("/catalogo")}>Volver al catálogo</a>
    </p>
  </div>
</Base>

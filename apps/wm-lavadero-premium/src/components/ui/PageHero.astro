---
/**
 * Hero del kit: kicker + titular con mascara linea por linea + subtitulo +
 * UN CTA + video de fondo que se ENCOGE con el scroll (sticky + script).
 *
 * Todo el movimiento es CSS salvo el "encogimiento", que usa un unico
 * listener de scroll con rAF (transform unicamente: no layout).
 */
import { appUrl } from "@lib/urls";
import LiveNow from "./LiveNow.astro";
import type { HeroContent } from "@lib/types";

export interface Props {
  hero: HeroContent;
  brand: string;
}

const { hero, brand } = Astro.props;
---

<section data-wm-hero class="relative" aria-label={`Portada de ${brand}`}>
  <!-- Pista de scroll: el sticky ocupa 100svh y se encoge el video. -->
  <div class="relative" style="height: 145svh">
    <div class="wm-hero-sticky sticky top-0 h-svh overflow-hidden">
      <div class="wm-hero-media wm-grade wm-grain wm-vignette absolute inset-0">
        <video
          class="h-full w-full object-cover"
          src={hero.video.src}
          poster={hero.video.poster}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={hero.video.alt}
        ></video>
      </div>

      {/* Scrim: el titular tiene que leerse SIEMPRE, sea cual sea el frame del video. */}
      <div
        class="pointer-events-none absolute inset-0 z-[2]"
        style="background:
          linear-gradient(to top, var(--wm-bg) 0%, color-mix(in oklab, var(--wm-bg) 62%, transparent) 42%, color-mix(in oklab, var(--wm-bg) 22%, transparent) 100%),
          linear-gradient(to right, color-mix(in oklab, var(--wm-bg) 72%, transparent) 0%, transparent 58%)"
      >
      </div>

      <div class="absolute inset-0 z-[3] flex flex-col justify-end">
        <div class="wm-container pb-20 sm:pb-28">
          <div class="max-w-3xl">
            <p class="wm-kicker">{hero.kicker}</p>

            <h1 class="wm-display mt-6 text-[clamp(2.8rem,9vw,7.5rem)]">
              <span class="wm-lines">
                {
                  hero.title.map((line, i) => (
                    <span style={`--wm-line-index:${i}`}>
                      <span class={i === hero.title.length - 1 ? "text-accent" : undefined}>
                        {line}
                      </span>
                    </span>
                  ))
                }
              </span>
            </h1>

            <p class="mt-7 max-w-xl text-lg leading-relaxed text-muted">{hero.subtitle}</p>

            <div class="mt-9 flex flex-wrap items-center gap-4">
              <a href={appUrl(hero.cta.href)} class="wm-btn">{hero.cta.label}</a>
              {
                hero.live && (
                  <span class="text-sm text-accent">
                    <LiveNow signal={hero.live} />
                  </span>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* El video se encoge con el scroll: solo transform (GPU). */
  .wm-hero-media {
    transform: scale3d(var(--wm-hero-scale, 1), var(--wm-hero-scale, 1), 1);
    transform-origin: center top;
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .wm-hero-media {
      transform: none;
      will-change: auto;
    }
  }
</style>

<script>
  // El hero se encoge al scrollear. Un solo listener, rAF, solo transform.
  const MIN = 0.72; // escala final
  let ticking = false;

  const update = () => {
    const hero = document.querySelector<HTMLElement>("[data-wm-hero]");
    if (hero) {
      const runway = hero.firstElementChild as HTMLElement | null;
      const distance = Math.max(1, (runway?.offsetHeight ?? hero.offsetHeight) - window.innerHeight);
      const progress = Math.min(1, Math.max(0, window.scrollY / distance));
      const scale = 1 - (1 - MIN) * progress;
      hero.style.setProperty("--wm-hero-scale", scale.toFixed(4));
    }
    ticking = false;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    },
    { passive: true },
  );

  update();

  // Tras una navegacion con astro:transitions el DOM cambia: recalcular.
  document.addEventListener("astro:page-load", update);
</script>

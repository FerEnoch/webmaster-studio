---
/**
 * Tarjeta de un item de catalogo (lavado por tamano, nivel de lavado o
 * paquete). Muestra precio final, duracion y el detalle en puntos.
 */
import type { CatalogItem } from "@lib/types";

export interface Props {
  item: CatalogItem;
  index?: number;
}

const { item, index = 0 } = Astro.props;
---

<article class="gg-editorial-card relative flex h-full flex-col">
  <span class="gg-card-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
  <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
    <div>
      {item.kicker ? (
        <p class="text-xs uppercase tracking-[0.2em] text-muted">{item.kicker}</p>
      ) : null}
      <h3 class="gg-display mt-2 text-3xl leading-tight">{item.title}</h3>
    </div>
    {item.badge ? <span class="gg-tag">{item.badge}</span> : null}
  </div>

  <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>

  {
    item.points?.length ? (
      <ul class="mt-4 space-y-1.5 text-sm text-muted">
        {item.points.map((p) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-accent">→</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    ) : null
  }

  {
    item.meta?.length ? (
      <dl class="mt-5 flex flex-wrap gap-4 text-xs uppercase tracking-[0.14em] text-muted">
        {item.meta.map((m) => (
          <div>
            <dt class="inline">{m.label}:</dt>{" "}
            <dd class="inline font-semibold text-fg">{m.value}</dd>
          </div>
        ))}
      </dl>
    ) : null
  }

  {
    item.price ? (
      <div class="gg-card-price mt-auto">
        <span class="gg-price">{item.price.amount}</span>
        {item.price.note ? <span class="text-xs text-muted">{item.price.note}</span> : null}
      </div>
    ) : null
  }
</article>

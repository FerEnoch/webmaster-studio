---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import PrepTimeline from "../components/PrepTimeline.astro";
import StudyCard from "../components/StudyCard.astro";
import { clinica } from "../content/clinica";

const estudios = clinica.sections.find((s) => s.id === "estudios")!;
---

<Base content={clinica} title={`Estudios · ${clinica.brand}`}>
  <PageHead
    kicker={estudios.kicker ?? "Diagnóstico por imágenes"}
    title="Cinco estudios, cinco preparaciones"
    subtitle={estudios.body}
  />

  <section class="wm-container pb-16">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {estudios.items?.map((item, i) => <StudyCard item={item} index={i} />)}
    </div>
  </section>

  <PrepTimeline items={estudios.items ?? []} />

  <section class="wm-container pb-24">
    <div class="rounded-wm-lg border border-line p-8 sm:p-12">
      <p class="wm-kicker">¿Te sirve un estudio en particular?</p>
      <h2 class="wm-display mt-5 text-[clamp(1.8rem,4.5vw,2.8rem)]">
        Pedí el turno con la preparación ya indicada
      </h2>
      <p class="mt-4 max-w-xl text-muted">
        Cuando reservás desde la web, la preparación del estudio aparece en el
        pase, así no llegás sin saber qué hacer.
      </p>
      <a href="/#turno" class="wm-btn mt-8">Ir a sacar el turno</a>
    </div>
  </section>
</Base>

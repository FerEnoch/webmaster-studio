---
/**
 * La conversion principal: los 3 pasos explicados + la isla React de Booking.
 */
import Booking from "./ui/Booking.tsx";
import type { Conversion } from "@lib/types";

export interface Props {
  conversion: Conversion;
  brand: string;
  whatsapp: { phone: string; template: string };
}

const { conversion, brand, whatsapp } = Astro.props;
---

<section id="turno" class="wm-container relative py-20 sm:py-28">
  <div class="max-w-2xl">
    <p class="wm-kicker">{conversion.kicker}</p>
    <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{conversion.title}</h2>
    {conversion.body ? <p class="mt-5 text-muted">{conversion.body}</p> : null}
  </div>

  <ol class="mt-10 grid gap-4 sm:grid-cols-3">
    {
      conversion.steps.map((step, i) => (
        <li class="rounded-wm border border-line p-5">
          <span class="wm-display text-3xl text-accent">{String(i + 1).padStart(2, "0")}</span>
          <p class="mt-2 font-semibold">{step}</p>
          <p class="mt-1 text-sm text-muted">
            {i === 0 && "Elegís el estudio y cargás tus datos."}
            {i === 1 && "Ves los horarios con lugares disponibles."}
            {i === 2 && "Recibís el pase con código para mostrar en recepción."}
          </p>
        </li>
      ))
    }
  </ol>

  <div class="mt-12">
    <Booking
      client:visible
      brand={brand}
      title={conversion.title}
      steps={conversion.steps}
      options={conversion.options}
      slots={conversion.slots}
      demoNotice={conversion.demoNotice}
      whatsapp={whatsapp}
      confirmLabel="Confirmar mi turno"
    />
  </div>
</section>

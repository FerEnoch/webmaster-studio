---
/**
 * Seccion "pinned": la preparacion de cada estudio, paso a paso.
 *
 * Es la seccion que cuenta algo: por que el estudio sale bien depende de
 * como llegaste. La implementan todas las apps del kit (una por rubro).
 */
import type { CatalogItem } from "@lib/types";

export interface Props {
  items: CatalogItem[];
  title?: string;
  kicker?: string;
}

const { items, title = "Cómo prepararte", kicker = "Preparación" } = Astro.props;
---

<section class="wm-container relative py-20 sm:py-28">
  <header class="max-w-2xl">
    <p class="wm-kicker">{kicker}</p>
    <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{title}</h2>
    <p class="mt-5 text-muted">
      Si seguís esta preparación, el estudio sale en la primera vuelta. Si algo
      no te sirve, escribinos y te damos la alternativa.
    </p>
  </header>

  <ol class="mt-14 border-l border-line">
    {
      items.map((item, i) => (
        <li class="relative grid gap-4 border-b border-line py-8 pl-8 md:grid-cols-[minmax(0,14rem)_1fr] md:gap-10 md:pl-12">
          <span
            aria-hidden="true"
            class="absolute top-8 -left-[0.42rem] flex h-3 w-3 rounded-full bg-accent"
          />
          <div>
            <p class="text-xs uppercase tracking-[0.24em] text-muted">
              Paso {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="wm-display mt-2 text-2xl leading-tight">{item.title}</h3>
            {item.meta ? (
              <p class="mt-2 text-sm text-muted">
                {item.meta.map((m) => `${m.label}: ${m.value}`).join(" · ")}
              </p>
            ) : null}
          </div>
          <ul class="space-y-2 text-muted">
            {(item.points ?? []).map((p) => (
              <li class="flex gap-3">
                <span aria-hidden="true" class="text-accent">→</span>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>

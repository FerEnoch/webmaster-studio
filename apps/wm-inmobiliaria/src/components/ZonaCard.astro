---
/**
 * Tarjeta de un barrio: precio medio, distancia a la oficina y perfil.
 * El CTA lleva al buscador con el barrio ya filtrado.
 */
import type { CatalogItem } from "@lib/types";

export interface Props {
  item: CatalogItem;
}

const { item } = Astro.props;
const perfil = item.meta?.find((m) => m.label === "Perfil")?.value;
const datos = (item.meta ?? []).filter((m) => m.label !== "Perfil");
---

<article class="wm-card relative flex h-full flex-col">
  <p class="wm-kicker">{perfil ?? "Barrio"}</p>
  <h3 class="wm-display mt-4 text-2xl leading-tight">{item.title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>

  {
    item.points?.length ? (
      <ul class="mt-4 space-y-1.5 text-sm text-muted">
        {item.points.map((p) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-accent">→</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    ) : null
  }

  <dl class="mt-5 flex flex-wrap gap-4 text-xs uppercase tracking-[0.14em] text-muted">
    {
      datos.map((m) => (
        <div>
          <dt class="inline">{m.label}:</dt>{" "}
          <dd class="inline font-semibold text-fg">{m.value}</dd>
        </div>
      ))
    }
  </dl>

  <div class="mt-auto pt-6">
    <a
      href={`/propiedades?zona=${encodeURIComponent(item.title)}`}
      class="wm-btn wm-btn--ghost w-full text-xs"
    >
      Ver propiedades en {item.title}
    </a>
  </div>
</article>

---
/**
 * Tarjeta del equipo: quien te atiende, de que zona se ocupa y cuando
 * esta disponible.
 */
import type { CatalogItem } from "@lib/types";

export interface Props {
  item: CatalogItem;
}

const { item } = Astro.props;
---

<article class="wm-card relative flex h-full flex-col">
  <div class="flex items-start justify-between gap-4">
    <h3 class="wm-display text-2xl leading-tight">{item.title}</h3>
    {item.badge ? <span class="wm-chip shrink-0">{item.badge}</span> : null}
  </div>

  <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>

  {
    item.points?.length ? (
      <ul class="mt-4 space-y-1.5 text-sm text-muted">
        {item.points.map((p) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-accent">→</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    ) : null
  }

  {
    item.meta?.length ? (
      <dl class="mt-5 flex flex-wrap gap-4 border-t border-line pt-4 text-xs uppercase tracking-[0.14em] text-muted">
        {item.meta.map((m) => (
          <div>
            <dt class="inline">{m.label}:</dt>{" "}
            <dd class="inline font-semibold text-fg">{m.value}</dd>
          </div>
        ))}
      </dl>
    ) : null
  }
</article>

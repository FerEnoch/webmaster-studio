---
/**
 * Seccion "pinned": como llega una propiedad a esta pagina.
 *
 * La columna izquierda queda FIJA (sticky) mientras la derecha se recorre:
 * es la seccion que cuenta algo y por eso se queda pegada.
 */
import type { MediaRef } from "@lib/types";

export interface Props {
  kicker?: string;
  title: string;
  body: string;
  foto: MediaRef;
}

const { kicker = "El informe CLAVE", title, body, foto } = Astro.props;

const pasos = [
  {
    n: "01",
    t: "Visita técnica",
    d: "Vamos con el propietario. Medimos, abrimos cada canilla, anotamos lo que anda y lo que no. Dura 40 minutos y no se corta aunque haya que bajar al subsuelo.",
  },
  {
    n: "02",
    t: "Fotos sin filtro",
    d: "Se toman con luz natural, en horizontal y sin gran angular. Si el living es chico, la foto lo muestra chico. No hay fotos de la otra punta de la habitación.",
  },
  {
    n: "03",
    t: "Mapa de imperfecciones",
    d: "Humedad, ruido de la caldera, macetas en el pasillo, el ascensor de cuatro personas. Va escrito en la ficha, con el mismo tamaño de letra que el resto.",
  },
  {
    n: "04",
    t: "Precio final",
    d: "El precio publicado ya incluye impuestos, gastos de escribana y comisión. Si el dueño quiere cobrar otra cosa, se publica otra cosa: no se arregla por teléfono.",
  },
];
---

<section class="wm-container py-20 sm:py-28">
  <div class="grid gap-12 lg:grid-cols-[minmax(0,24rem)_1fr] lg:gap-16">
    <!-- La columna que queda pegada mientras se corre la lista. -->
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="wm-kicker">{kicker}</p>
      <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.4rem)]">{title}</h2>
      <p class="mt-5 text-muted">{body}</p>

      <div class="wm-grade wm-grain wm-vignette mt-8 overflow-hidden rounded-wm-lg">
        <img
          src={foto.src}
          alt={foto.alt}
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
      </div>
    </div>

    <ol class="border-l border-line">
      {
        pasos.map((p) => (
          <li class="relative grid gap-3 border-b border-line py-8 pl-8 md:grid-cols-[7rem_1fr] md:gap-10 md:pl-12">
            <span aria-hidden="true" class="absolute top-8 -left-[0.42rem] flex h-3 w-3 rounded-full bg-accent" />
            <span class="wm-display text-4xl text-accent">{p.n}</span>
            <div>
              <h3 class="wm-display text-2xl leading-tight">{p.t}</h3>
              <p class="mt-3 text-muted">{p.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

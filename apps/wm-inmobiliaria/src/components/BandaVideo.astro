---
/**
 * Banda de video a pantalla completa: la foto/video de fondo con la misma
 * gradacion de la firma (grade + grain + vignette) y un scrim para que el
 * texto se lea siempre.
 */
import { appUrl } from "@lib/urls";

export interface Props {
  src: string;
  poster: string;
  alt: string;
  kicker: string;
  title: string;
  body: string;
  cta?: { label: string; href: string };
}

const { src, poster, alt, kicker, title, body, cta } = Astro.props;
---

<section class="relative overflow-hidden border-y border-line">
  <div class="wm-grade wm-grain wm-vignette absolute inset-0">
    <video
      class="h-full w-full object-cover"
      src={src}
      poster={poster}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-label={alt}
    ></video>
  </div>

  <div
    class="pointer-events-none absolute inset-0"
    style="background: linear-gradient(to right, var(--wm-bg) 0%, color-mix(in oklab, var(--wm-bg) 72%, transparent) 52%, transparent 100%)"
  >
  </div>

  <div class="wm-container relative py-24 sm:py-32">
    <p class="wm-kicker">{kicker}</p>
    <h2 class="wm-display mt-5 max-w-2xl text-[clamp(2rem,5vw,3.4rem)]">{title}</h2>
    <p class="mt-5 max-w-lg text-muted">{body}</p>
    {cta ? <a href={appUrl(cta.href)} class="wm-btn mt-8">{cta.label}</a> : null}
  </div>
</section>

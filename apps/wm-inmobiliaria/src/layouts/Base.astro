---
/**
 * Wrapper thin sobre el BaseLayout del kit.
 * Toda pagina de la app usa este layout y le pasa el contenido del rubro.
 *
 * Le agrega el CTA fijo de mobile: la conversion principal siempre a mano.
 */
import BaseLayout from "../components/ui/BaseLayout.astro";
import type { RubroContent } from "@lib/types";
import { waLink } from "@lib/whatsapp";
import "../styles/global.css";

export interface Props {
  content: RubroContent;
  title?: string;
  description?: string;
  ogType?: string;
}

const { content, title, description, ogType } = Astro.props;

const whatsappHref = waLink(
  content.contact.whatsapp,
  `Hola, escribo desde la web de ${content.brand}: quiero consultar por una propiedad.`,
);
---

<BaseLayout
  title={title ?? `${content.brand} · ${content.rubro}`}
  description={description ?? content.tagline}
  brand={content.brand}
  theme={content.theme}
  nav={content.nav}
  legal={content.legal}
  contact={content.contact}
  ogType={ogType}
  jsonLd={content.jsonLd}
>
  <slot />

  <!--
    CTA fijo de mobile: la conversion principal a un toque, siempre visible.
    En desktop el boton flotante de WhatsApp del kit hace la misma tarea
    (ver `styles/global.css`).
  -->
  <div
    class="wm-cta-movil fixed inset-x-0 bottom-0 z-40 border-t border-line bg-bg/95 backdrop-blur-xl md:hidden"
  >
    <div class="flex items-center gap-2 px-4 py-3">
      <a href="/#visita" class="wm-btn flex-1 text-xs">Agendar una visita</a>
      <a
        href={whatsappHref}
        aria-label="Escribir por WhatsApp"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-[#25d366] text-white transition-transform hover:scale-105"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.6-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.9s.7-2.1 1-2.4c.3-.3.6-.3.8-.3h.6c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .6l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1c.2-.1.4-.2.7-.1l2 .9c.3.1.5.2.5.3.1.2.1.7-.1 1.2Z"
          ></path>
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>

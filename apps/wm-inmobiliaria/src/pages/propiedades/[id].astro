---
import type { GetStaticPaths } from "astro";
import { appUrl } from "@lib/urls";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import { brand, inmobiliaria, propiedades, type Propiedad } from "../../content/inmobiliaria";
import { rubroWhatsapp } from "@lib/whatsapp";

export const getStaticPaths = (() =>
  propiedades.map((property) => ({
    params: { id: property.id },
    props: { property },
  }))) satisfies GetStaticPaths;

export interface Props {
  property: Propiedad;
}

const { property } = Astro.props;

const whatsappHref = rubroWhatsapp("inmobiliaria", {
  zona: `${property.zona}, ${property.title}`,
});

const fotos = property.fotos.length ? property.fotos : [property.media?.src ?? ""];
---

<Base
  content={inmobiliaria}
  title={`${property.title} · ${brand}`}
  description={`${property.kicker} · ${property.body}`}
  ogType="article"
>
  <PageHead kicker={property.kicker ?? property.zona} title={property.title} subtitle={property.body} />

  <section class="wm-container pb-16">
    <!-- Precio final: el dato que la gente busca primero. -->
    <div class="flex flex-wrap items-end justify-between gap-6 border-y border-line py-6">
      <div>
        <p class="text-xs uppercase tracking-[0.24em] text-muted">Precio de venta</p>
        <p class="wm-display mt-2 text-[clamp(2.2rem,6vw,4rem)] text-accent">
          {property.price?.amount ?? "A consultar"}
        </p>
      </div>
      <div class="max-w-sm">
        <p class="text-sm text-muted">
          {property.price?.note ?? "Consultar precio"}
        </p>
        <p class="mt-2 text-sm text-muted">
          Es el precio final: incluye impuestos, gastos de escribana y comisión.
        </p>
      </div>
    </div>

    <!-- Galeria -->
    <div class="mt-10 grid gap-4 lg:grid-cols-[1.6fr_1fr]">
      <div class="wm-grade wm-grain wm-vignette overflow-hidden rounded-wm-lg">
        <img
          src={fotos[0]}
          alt={property.media?.alt ?? property.title}
          loading="eager"
          decoding="async"
          class="aspect-[16/10] w-full object-cover lg:aspect-auto lg:h-full"
        />
      </div>
      <div class="grid gap-4">
        {
          fotos.slice(1, 3).map((src) => (
            <div class="wm-grade wm-grain wm-vignette overflow-hidden rounded-wm-lg">
              <img
                src={src}
                alt={`Vista adicional de ${property.title} (imagen de demostración).`}
                loading="lazy"
                decoding="async"
                class="aspect-[16/10] w-full object-cover lg:aspect-auto lg:h-full lg:min-h-[13rem]"
              />
            </div>
          ))
        }
      </div>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.35fr_1fr] lg:gap-14">
      <!-- Ficha tecnica -->
      <div>
        <p class="wm-kicker">Ficha técnica</p>
        <h2 class="wm-display mt-4 text-[clamp(1.8rem,4.5vw,2.6rem)]">Los números</h2>

        <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-wm border border-line bg-line sm:grid-cols-3">
          {
            (property.meta ?? []).map((m) => (
              <div class="bg-bg p-5">
                <dt class="text-xs uppercase tracking-[0.16em] text-muted">{m.label}</dt>
                <dd class="wm-display mt-2 text-xl">{m.value}</dd>
              </div>
            ))
          }
          <div class="bg-bg p-5">
            <dt class="text-xs uppercase tracking-[0.16em] text-muted">Zona</dt>
            <dd class="wm-display mt-2 text-xl">{property.zona}</dd>
          </div>
          <div class="bg-bg p-5">
            <dt class="text-xs uppercase tracking-[0.16em] text-muted">Tipo</dt>
            <dd class="wm-display mt-2 text-xl">{property.tipo}</dd>
          </div>
          <div class="bg-bg p-5">
            <dt class="text-xs uppercase tracking-[0.16em] text-muted">Ambientes</dt>
            <dd class="wm-display mt-2 text-xl">{property.ambientes}</dd>
          </div>
        </dl>

        {
          property.points?.length ? (
            <div class="mt-12">
              <p class="wm-kicker">Qué tiene</p>
              <ul class="mt-5 grid gap-2 sm:grid-cols-2">
                {property.points.map((p) => (
                  <li class="flex gap-3 text-muted">
                    <span aria-hidden="true" class="text-accent">→</span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
            </div>
          ) : null
        }

        {
          property.imperfecciones?.length ? (
            <div class="mt-12 rounded-wm-lg border border-line p-6 sm:p-8">
              <p class="wm-kicker">Imperfecciones publicadas</p>
              <h3 class="wm-display mt-4 text-2xl">Lo que hay que saber antes de ir</h3>
              <ul class="mt-5 space-y-3">
                {property.imperfecciones.map((d) => (
                  <li class="flex gap-3 text-muted">
                    <span aria-hidden="true" class="text-accent">→</span>
                    <span>{d}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-5 text-sm text-muted">
                Las detectamos en la visita técnica. No son un inventario de obra: si
                encontrás otra cosa, contás y la anotamos.
              </p>
            </div>
          ) : null
        }
      </div>

      <!-- Conversion -->
      <aside class="lg:sticky lg:top-28 lg:h-fit">
        <div class="wm-card">
          <p class="wm-kicker">Visita</p>
          <h2 class="wm-display mt-4 text-2xl leading-tight">Agendá esta propiedad</h2>
          <p class="mt-3 text-sm text-muted">
            Elegís día y hora, dejás tus datos y recibís el pase con código. La visita
            dura entre 30 y 45 minutos.
          </p>

          <a href={appUrl(`/?prop=${property.id}#visita`)} class="wm-btn mt-6 w-full">
            Agendar una visita
          </a>
          <a href={whatsappHref} class="wm-btn wm-btn--ghost mt-3 w-full">
            Consultar por WhatsApp
          </a>

          <p class="mt-5 border-t border-line pt-4 text-xs leading-relaxed text-muted">
            Demo de portfolio: la propiedad, el precio y las fotos son ficticios. La
            reserva no envía datos a ningún servidor.
          </p>
        </div>

        <a
          href={appUrl("/propiedades")}
          class="mt-4 inline-block text-sm text-muted underline underline-offset-4 transition-colors hover:text-fg"
        >
          ← Volver a todas las propiedades
        </a>
      </aside>
    </div>
  </section>
</Base>

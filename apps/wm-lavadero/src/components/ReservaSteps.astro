---
/**
 * La conversion principal: los 4 pasos explicados + la isla React de
 * LavadoBooking (que termina en el Ticket del kit).
 */
import LavadoBooking from "./LavadoBooking.tsx";
import type { CatalogItem, Conversion, Slot } from "@lib/types";

export interface Props {
  conversion: Conversion;
  brand: string;
  rubroId: string;
  servicios: CatalogItem[];
  addons: CatalogItem[];
  precios: Record<string, Record<string, number>>;
  preciosAddons: Record<string, number>;
  sena: number;
}

const { conversion, brand, rubroId, servicios, addons, precios, preciosAddons, sena } = Astro.props;

/** Lo que pasa en cada paso, en una linea. */
const descripciones = [
  "Decinos el tamaño de tu auto: el precio sale de ahí.",
  "Elegí el nivel de lavado y sumá los extras que quieras.",
  "Elegí el turno, dejanos tus datos y pagás la seña del 20%.",
  "Te damos el pase con código, la hora de entrega y el monto de la seña.",
];
---

<section id={conversion.id} class="wm-container relative py-20 sm:py-28">
  <div class="max-w-2xl">
    <p class="wm-kicker">{conversion.kicker}</p>
    <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{conversion.title}</h2>
    {conversion.body ? <p class="mt-5 text-muted">{conversion.body}</p> : null}
  </div>

  <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      conversion.steps.map((step, i) => (
        <li class="rounded-wm border border-line p-5">
          <span class="wm-display text-3xl text-accent">{String(i + 1).padStart(2, "0")}</span>
          <p class="mt-2 font-semibold">{step}</p>
          <p class="mt-1 text-sm text-muted">{descripciones[i] ?? ""}</p>
        </li>
      ))
    }
  </ol>

  <div class="mt-12">
    <LavadoBooking
      client:load
      brand={brand}
      title={conversion.title}
      steps={conversion.steps}
      options={conversion.options}
      servicios={servicios}
      addons={addons}
      precios={precios}
      preciosAddons={preciosAddons}
      slots={conversion.slots as Slot[]}
      sena={sena}
      demoNotice={conversion.demoNotice}
      rubroId={rubroId}
    />
  </div>
</section>

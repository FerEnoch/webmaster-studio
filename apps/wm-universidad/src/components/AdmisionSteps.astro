---
/**
 * La conversion principal: los 4 pasos explicados + la isla React de admision.
 *
 * Termina en el TICKET del kit, con la carrera elegida, el turno de visita y
 * el codigo de seguimiento.
 */
import AdmisionFlow from "./AdmisionFlow.tsx";
import { carreras, turnos } from "../content/universidades";
import type { RubroContent } from "@lib/types";

export interface Props {
  conversion: RubroContent["conversion"];
  brand: string;
  /** Link al formulario de inscripcion (demo). */
  inscriptionHref?: string;
}

const { conversion, brand, inscriptionHref = "/admision#inscripcion" } = Astro.props;

const descripciones = [
  "Elegís la carrera que te interesa y ves la salida laboral antes de nada.",
  "Decís cómo la vas a cursar: presencial en campus o online con prácticas.",
  "Elegís el turno de la visita guiada (o la videollamada) y dejás tus datos.",
  "Te damos el pase con el código de seguimiento y el link para seguir.",
];
---

<section id="admision" class="wm-container relative py-20 sm:py-28">
  <div class="max-w-2xl">
    <p class="wm-kicker">{conversion.kicker}</p>
    <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{conversion.title}</h2>
    {conversion.body ? <p class="mt-5 text-muted">{conversion.body}</p> : null}
  </div>

  <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      conversion.steps.map((step, i) => (
        <li class="rounded-wm border border-line p-5">
          <span class="wm-display text-3xl text-accent">{String(i + 1).padStart(2, "0")}</span>
          <p class="mt-2 font-semibold">{step}</p>
          <p class="mt-1 text-sm text-muted">{descripciones[i] ?? ""}</p>
        </li>
      ))
    }
  </ol>

  <div class="mt-12">
    <AdmisionFlow
      client:load
      brand={brand}
      title={conversion.title}
      kicker={conversion.kicker}
      body={conversion.body}
      steps={conversion.steps}
      carreras={carreras}
      turnos={turnos}
      demoNotice={conversion.demoNotice}
      inscriptionHref={inscriptionHref}
    />
  </div>
</section>

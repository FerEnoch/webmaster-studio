---
/**
 * Tarjeta de campus o sede: direccion, que hay ahi y como llegar.
 */
import type { CatalogItem } from "@lib/types";

export interface Props {
  item: CatalogItem;
  mapsUrl?: string;
}

const { item, mapsUrl } = Astro.props;
---

<article class="wm-card flex h-full flex-col">
  <h3 class="wm-display text-2xl">{item.title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>

  {
    item.points?.length ? (
      <ul class="mt-4 space-y-1.5 text-sm text-muted">
        {item.points.map((p) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-accent">→</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    ) : null
  }

  {
    item.meta?.length ? (
      <p class="mt-5 text-sm font-semibold text-accent">
        {item.meta.map((m) => m.value).join(" · ")}
      </p>
    ) : null
  }

  {
    mapsUrl && (
      <a
        href={mapsUrl}
        target="_blank"
        rel="noreferrer noopener"
        class="mt-auto pt-6 text-sm font-semibold underline underline-offset-4"
      >
        Cómo llegar
      </a>
    )
  }
</article>

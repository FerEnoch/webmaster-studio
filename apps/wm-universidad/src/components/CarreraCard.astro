---
/**
 * Tarjeta de una carrera: area, duracion, sede, modalidad, salida laboral y
 * arancel final con impuestos.
 */
import type { Carrera } from "../content/universidades";

export interface Props {
  item: Carrera;
  index?: number;
}

const { item, index = 0 } = Astro.props;
---

<article class="wm-card relative flex h-full flex-col" style={`--wm-line-index:${index}`}>
  <div class="flex items-start justify-between gap-3">
    <span class="wm-chip shrink-0">{item.area}</span>
    {item.badge ? <span class="text-xs uppercase tracking-[0.14em] text-muted">{item.badge}</span> : null}
  </div>

  <h3 class="wm-display mt-4 text-2xl leading-tight">{item.title}</h3>
  <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>

  <dl class="mt-5 space-y-2 text-xs uppercase tracking-[0.14em] text-muted">
    {
      item.meta?.map((m) => (
        <div class="flex items-baseline justify-between gap-3">
          <dt>{m.label}</dt>
          <dd class="text-right font-semibold text-fg">{m.value}</dd>
        </div>
      ))
    }
  </dl>

  <p class="mt-4 border-l-2 border-accent pl-3 text-sm text-muted">
    <span class="block text-xs uppercase tracking-[0.14em]">Salida laboral</span>
    <span class="mt-1 block text-fg">{item.salida}</span>
  </p>

  {
    item.points?.length ? (
      <ul class="mt-4 space-y-1.5 text-sm text-muted">
        {item.points.map((p) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-accent">→</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    ) : null
  }

  {
    item.price ? (
      <div class="mt-auto flex items-baseline justify-between gap-4 border-t border-line pt-5">
        <span class="wm-display text-2xl text-accent">{item.price.amount}</span>
        {item.price.note ? <span class="text-xs text-muted">{item.price.note}</span> : null}
      </div>
    ) : null
  }
</article>

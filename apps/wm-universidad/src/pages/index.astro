---
/**
 * PLACEHOLDER — el writer reemplaza este archivo por la portada real.
 * Es standalone a proposito: una app recien scaffoldeada compila sin
 * todavia tener el archivo `src/content/<rubro>.ts`.
 */
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Webmaster Studio</title>
  </head>
  <body style="font-family: system-ui, sans-serif; padding: 3rem; line-height: 1.6">
    <h1>App scaffolded</h1>
    <p>
      Reemplazá <code>src/pages/index.astro</code> por la portada del rubro y
      creá <code>src/content/&lt;rubro&gt;.ts</code>.
    </p>
  </body>
</html>

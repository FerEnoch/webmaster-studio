---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import SedeCard from "../components/SedeCard.astro";
import { universidad } from "../content/universidades";
import { rubroWhatsapp } from "@lib/whatsapp";

const seccionCampus = universidad.sections.find((s) => s.id === "campus")!;
const whatsappHref = rubroWhatsapp("universidad", {});
---

<Base content={universidad} title={`Contacto · ${universidad.brand}`}>
  <PageHead
    kicker="Contacto"
    title="Un WhatsApp, un campus, tres horarios"
    subtitle="Escribinos con el nombre de la carrera que te interesa y te respondemos en el día. Si preferís, agendá la visita guiada desde el paso a paso."
  />

  <section class="wm-container pb-16">
    <div class="grid gap-5 md:grid-cols-3">
      {
        seccionCampus.items?.map((sede) => (
          <SedeCard item={sede} mapsUrl={universidad.contact.mapsUrl} />
        ))
      }
    </div>
  </section>

  <section class="wm-container pb-20">
    <div class="grid gap-10 lg:grid-cols-2">
      <div class="rounded-wm-lg border border-line p-8">
        <p class="wm-kicker">Datos</p>
        <dl class="mt-6 space-y-4 text-muted">
          <div>
            <dt class="text-xs uppercase tracking-[0.14em]">Teléfono</dt>
            <dd class="mt-1 text-lg text-fg">{universidad.contact.phone}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.14em]">Email</dt>
            <dd class="mt-1 text-lg text-fg">
              <a href={`mailto:${universidad.contact.email}`} class="hover:text-accent">
                {universidad.contact.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.14em]">Horarios</dt>
            <dd class="mt-1 text-lg text-fg">{universidad.contact.hours}</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.14em]">Dirección</dt>
            <dd class="mt-1 text-lg text-fg">{universidad.contact.address}</dd>
          </div>
        </dl>

        <a href={whatsappHref} class="wm-btn mt-8">Escribir por WhatsApp</a>

        <p class="mt-6 border-t border-line pt-5 text-sm text-muted">
          Demo de portfolio: el teléfono, el email y el domicilio son ficticios.
        </p>
      </div>

      <div>
        <p class="wm-kicker">Mensaje</p>
        <h2 class="wm-display mt-5 text-[clamp(1.8rem,4.5vw,2.8rem)]">
          Contanos qué querés cursar y te orientamos
        </h2>
        <p class="mt-5 text-muted">
          Si no sabés qué carrera elegir, decinos qué te gusta hacer y te
          decimos qué se estudia acá. Si ya sabés, pedí el turno de la visita
          guiada: es el paso que más rápido resuelve las dudas.
        </p>

        <form class="mt-8 grid gap-4" data-wm-demo-form>
          <label class="block text-sm">
            <span class="text-muted">Nombre</span>
            <input
              required
              placeholder="Ana Gomez"
              class="mt-1 w-full rounded-wm border border-line bg-bg px-4 py-3 outline-none placeholder:text-muted focus:border-accent"
            />
          </label>
          <label class="block text-sm">
            <span class="text-muted">Teléfono o email</span>
            <input
              required
              placeholder="11 1234 5678"
              class="mt-1 w-full rounded-wm border border-line bg-bg px-4 py-3 outline-none placeholder:text-muted focus:border-accent"
            />
          </label>
          <label class="block text-sm">
            <span class="text-muted">¿Qué necesitás?</span>
            <textarea
              rows="4"
              placeholder="Carrera que te interesa, becas, visita al campus..."
              class="mt-1 w-full rounded-wm border border-line bg-bg px-4 py-3 outline-none placeholder:text-muted focus:border-accent"></textarea>
          </label>
          <button type="submit" class="wm-btn w-full">Enviar mensaje</button>
          <p class="text-xs text-muted">Demo: no se envían datos.</p>
        </form>

        <p class="mt-4 hidden rounded-wm border border-accent p-4 text-sm" data-wm-demo-done>
          Mensaje tomado. En esta demo no se envía nada: así se vería la
          confirmación.
        </p>
      </div>
    </div>
  </section>
</Base>

<script>
  // Formulario de contacto (demo): no manda datos, muestra la confirmacion.
  document.addEventListener(
    "submit",
    (event) => {
    const form = event.target as HTMLFormElement | null;
    if (!form || !form.matches("[data-wm-demo-form]")) return;
    event.preventDefault();
    form.style.display = "none";
    const done = document.querySelector<HTMLElement>("[data-wm-demo-done]");
    if (done) {
      done.classList.remove("hidden");
      done.removeAttribute("hidden");
    }
    },
    true,
  );
</script>

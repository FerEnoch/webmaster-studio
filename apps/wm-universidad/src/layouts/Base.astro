---
/**
 * Wrapper thin sobre el BaseLayout del kit.
 * Toda pagina de la app usa este layout y le pasa el contenido del rubro.
 */
import BaseLayout from "../components/ui/BaseLayout.astro";
import CtaMovil from "../components/CtaMovil.astro";
import { rubroWhatsapp } from "@lib/whatsapp";
import type { RubroContent } from "@lib/types";
import "../styles/global.css";

export interface Props {
  content: RubroContent;
  title?: string;
  description?: string;
  ogType?: string;
}

const { content, title, description, ogType } = Astro.props;
const whatsappHref = rubroWhatsapp(content.id, {});

/** El paso a paso vive en la portada; el resto de las rutas van a /admision. */
const esPortada = Astro.url.pathname.replace(/\/$/, "") === "";
const ctaHref = esPortada ? `#${content.conversion.id}` : `/admision#${content.conversion.id}`;
---

<BaseLayout
  title={title ?? `${content.brand} · ${content.rubro}`}
  description={description ?? content.tagline}
  brand={content.brand}
  theme={content.theme}
  nav={content.nav}
  legal={content.legal}
  contact={content.contact}
  ogType={ogType}
  jsonLd={content.jsonLd}
>
  <slot />

  <!-- CTA fijo de mobile: la conversion queda al alcance del pulgar. -->
  <CtaMovil label="Agendar mi visita" href={ctaHref} whatsappHref={whatsappHref} />
</BaseLayout>

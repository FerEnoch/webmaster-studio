---
/**
 * OBRAS — el archivo de obras con su antes y su después.
 *
 * El filtro por tipo es un boton que cambia `data-tipo` en el contenedor:
 * sin JavaScript de framework y sin recargar. La pieza 3D de cada obra se
 * enlaza al modelo navegable de la portada.
 */
import { appUrl } from "@lib/urls";
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import AntesDespues from "../components/AntesDespues.astro";
import { arquitecturaPremium, obras } from "../content/arquitectura-premium";

const { brand } = arquitecturaPremium;

const tipos = ["Todas", "Obra nueva", "Reforma", "Comercial"];
---

<Base content={arquitecturaPremium} title={`Obras · ${brand}`}>
  <PageHead
    kicker="Obras"
    title="El archivo, con su antes y su después"
    subtitle="Cada obra con su ficha completa: año, superficie, estado, tipo, equipo y entregables. El antes y el después se comparan deslizando."
  />

  <section class="wm-container py-14" data-obras>
    <div class="vt-filter" role="group" aria-label="Filtrar obras por tipo">
      {
        tipos.map((tipo, i) => (
          <button type="button" data-filtro={tipo} aria-pressed={i === 0 ? "true" : "false"}>
            {tipo}
          </button>
        ))
      }
    </div>

    <div class="vt-obras">
      {
        obras.map((obra) => (
          <article class="vt-obras__row" data-tipo={obra.tipo}>
            <div>
              <h2 class="vt-step__title">{obra.title}</h2>
              <p class="mt-3 text-sm text-[var(--vt-dim)]">
                {obra.year} · {obra.zona}
              </p>
              <div class="vt-obras__tags">
                <span class="vt-obras__tag">{obra.tipo}</span>
                <span class="vt-obras__tag">{obra.estado}</span>
                <span class="vt-obras__tag">{obra.superficie}</span>
              </div>
            </div>

            <div>
              <p class="vt-obras__body">{obra.resumen}</p>
              <ul class="vt-step__points mt-5">
                {obra.entregables.map((entregable) => (
                  <li>{entregable}</li>
                ))}
              </ul>
              <p class="mt-5 text-sm text-[var(--vt-dim)]">
                <span class="text-[var(--wm-fg)]">Equipo:</span> {obra.equipo.join(", ")}
              </p>
            </div>

            <div>
              {
                obra.antes && obra.despues ? (
                  <AntesDespues antes={obra.antes} despues={obra.despues} />
                ) : (
                  obra.despues && (
                    <figure>
                      <img
                        src={obra.despues.src}
                        alt={obra.despues.alt}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[16/10] w-full object-cover"
                      />
                    </figure>
                  )
                )
              }
              {obra.nota ? <p class="vt-caption">{obra.nota}</p> : null}
            </div>
          </article>
        ))
      }
    </div>

    <p class="vt-note mt-10">
      Imágenes de demostración: ilustran estados de obra para mostrar el antes y el después. No
      son fotografías de estas obras, que son ficticias.
    </p>
  </section>

  <section class="wm-container pb-20">
    <div class="vt-cta">
      <div>
        <p class="wm-kicker">Tu proyecto</p>
        <p class="vt-cta__title mt-5">¿Querés ver el tuyo en modelo antes de cotizar?</p>
        <p class="mt-4 text-[var(--vt-dim)]">
          En la portada está el modelo navegable con el que trabajamos la primera visita. Mismo
          ejercicio, con tus medidas.
        </p>
      </div>
      <a href={appUrl("/")} class="wm-btn">Ver el modelo</a>
    </div>
  </section>
</Base>

<script>
  /**
   * Filtro del archivo: un atributo en el contenedor y CSS decide.
   * Sin framework y sin recargar la pagina.
   */
  const inicializar = () => {
    const archivo = document.querySelector<HTMLElement>("[data-obras]");
    if (!archivo || archivo.dataset.vtFiltro === "true") return;
    archivo.dataset.vtFiltro = "true";

    const botones = Array.from(archivo.querySelectorAll<HTMLElement>("[data-filtro]"));
    const filas = Array.from(archivo.querySelectorAll<HTMLElement>("[data-tipo]"));

    botones.forEach((boton) => {
      boton.addEventListener("click", () => {
        const tipo = boton.dataset.filtro ?? "Todas";
        botones.forEach((otro) => {
          otro.setAttribute("aria-pressed", otro === boton ? "true" : "false");
        });
        filas.forEach((fila) => {
          fila.hidden = tipo !== "Todas" && fila.dataset.tipo !== tipo;
        });
      });
    });
  };

  document.addEventListener("astro:page-load", inicializar);
  inicializar();
</script>

---
/**
 * Tarjeta de un servicio de ESTUDIO TRAZO.
 * Muestra el honorario de referencia (precio final con impuestos), el plazo
 * y que incluye cada tipo de trabajo.
 */
import type { CatalogItem } from "@lib/types";

export interface Props {
  item: CatalogItem;
  index?: number;
}

const { item, index = 0 } = Astro.props;
---

<article class="wm-card relative flex h-full flex-col" style={`--wm-line-index:${index}`}>
  <div class="flex items-start justify-between gap-4">
    {item.kicker ? <p class="wm-kicker">{item.kicker}</p> : null}
    {item.badge ? <span class="wm-chip shrink-0">{item.badge}</span> : null}
  </div>

  <h3 class="wm-display mt-4 text-2xl leading-tight">{item.title}</h3>

  <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>

  {
    item.points?.length ? (
      <ul class="mt-4 space-y-1.5 text-sm text-muted">
        {item.points.map((p) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-accent">→</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    ) : null
  }

  {
    item.meta?.length ? (
      <dl class="mt-5 flex flex-wrap gap-4 text-xs uppercase tracking-[0.14em] text-muted">
        {item.meta.map((m) => (
          <div>
            <dt class="inline">{m.label}:</dt>{" "}
            <dd class="inline font-semibold text-fg">{m.value}</dd>
          </div>
        ))}
      </dl>
    ) : null
  }

  {
    item.price ? (
      <div class="mt-auto flex items-baseline justify-between gap-4 border-t border-line pt-5">
        <span class="wm-display text-2xl text-accent">{item.price.amount}</span>
        {item.price.note ? <span class="text-xs text-muted">{item.price.note}</span> : null}
      </div>
    ) : null
  }
</article>

---
/**
 * Card de rubro para el portfolio madre: imagen, rubro, bajada,
 * la objecion que responde y el link a la demo.
 */
import type { Rubro } from "@lib/rubros";

export interface Props {
  rubro: Rubro;
  image?: string;
  imageAlt?: string;
}

const { rubro, image, imageAlt } = Astro.props;
---

<article class="wm-card group relative overflow-hidden">
  {
    image && (
      <div class="wm-grade wm-grain wm-vignette mb-6 overflow-hidden rounded-wm">
        <img
          src={image}
          alt={imageAlt ?? rubro.rubro}
          loading="lazy"
          decoding="async"
          class="aspect-[16/10] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
        />
      </div>
    )
  }

  <p class="wm-kicker">{rubro.nombre}</p>

  <h3 class="wm-display mt-4 text-3xl leading-tight">{rubro.rubro}</h3>

  <p class="mt-3 text-muted">{rubro.tagline}</p>

  <p class="mt-5 border-l-2 border-accent pl-4 text-sm italic text-muted">
    {rubro.objeccion}
  </p>

  <a
    href={rubro.demoUrl}
    target="_blank"
    rel="noreferrer noopener"
    class="wm-btn mt-7 w-full sm:w-auto"
  >
    Ver la demo
  </a>

  <p class="mt-3 text-xs text-muted">Puerto local: {rubro.port}</p>
</article>

---
/**
 * La conversion principal: los 4 pasos explicados + la isla React.
 */
import Cotizacion from "./Cotizacion.tsx";
import type { ConversionArq } from "../content/arquitectura";

export interface Props {
  conversion: ConversionArq;
  brand: string;
  rubroId: string;
}

const { conversion, brand, rubroId } = Astro.props;

const descripciones = [
  "Elegís el tipo de trabajo: proyecto, dirección de obra, interiorismo o permisos.",
  "Cargás la escala: el estudio sabe en cuánto tiempo y con qué entregables.",
  "Dejás tus datos y en qué zona está el proyecto.",
  "Recibís un número de consulta para el estudio, con todo lo que pediste.",
];
---

<section id="cotizacion" class="wm-container relative py-20 sm:py-28">
  <div class="max-w-2xl">
    <p class="wm-kicker">{conversion.kicker}</p>
    <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{conversion.title}</h2>
    {conversion.body ? <p class="mt-5 text-muted">{conversion.body}</p> : null}
  </div>

  <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      conversion.steps.map((step, i) => (
        <li class="rounded-wm border border-line p-5">
          <span class="wm-display text-3xl text-accent">{String(i + 1).padStart(2, "0")}</span>
          <p class="mt-2 font-semibold">{step}</p>
          <p class="mt-1 text-sm text-muted">{descripciones[i]}</p>
        </li>
      ))
    }
  </ol>

  <div class="mt-12">
    <Cotizacion client:load brand={brand} conversion={conversion} rubroId={rubroId} />
  </div>
</section>

---
/**
 * Tarjeta de una clase de yoga.
 * La clase se vende por RESULTADO (descanso, movilidad, fuerza, ansiedad),
 * con horario, docente y precio.
 */
import type { CatalogItem } from "@lib/types";

export interface Props {
  item: CatalogItem;
  index?: number;
}

const { item, index = 0 } = Astro.props;
const horario = item.meta?.find((m) => m.label === "Horario")?.value ?? "";
const docente = item.meta?.find((m) => m.label === "Docente")?.value ?? "";
const duracion = item.meta?.find((m) => m.label === "Duración")?.value ?? "";
---

<article
  class="wm-card group relative flex h-full flex-col border-t-2 border-transparent transition-colors hover:border-accent"
  style={`--wm-line-index:${index}`}
>
  {/* El chip va arriba y no al lado: a 375 px el título largo + el chip
      desbordaban la tarjeta. */}
  {item.badge ? <span class="wm-chip mb-3 self-start">{item.badge}</span> : null}
  <h3 class="wm-display text-3xl leading-none">{item.title}</h3>

  <p class="mt-4 text-sm leading-relaxed text-muted">{item.body}</p>

  {
    item.points?.length ? (
      <ul class="mt-4 space-y-1.5 text-sm text-muted">
        {item.points.map((p) => (
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-accent">→</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    ) : null
  }

  <dl class="mt-6 grid gap-2 border-t border-line pt-5 text-sm">
    <div class="flex items-baseline justify-between gap-4">
      <dt class="text-xs uppercase tracking-[0.14em] text-muted">Horario</dt>
      <dd class="font-semibold text-fg">{horario}</dd>
    </div>
    <div class="flex items-baseline justify-between gap-4">
      <dt class="text-xs uppercase tracking-[0.14em] text-muted">Docente</dt>
      <dd class="text-right font-medium">{docente}</dd>
    </div>
    <div class="flex items-baseline justify-between gap-4">
      <dt class="text-xs uppercase tracking-[0.14em] text-muted">Duración</dt>
      <dd class="font-medium">{duracion}</dd>
    </div>
  </dl>

  {
    item.price ? (
      <div class="mt-auto flex items-baseline justify-between gap-4 pt-5">
        <span class="wm-display text-2xl text-accent">{item.price.amount}</span>
        {item.price.note ? <span class="text-xs text-muted">{item.price.note}</span> : null}
      </div>
    ) : null
  }
</article>

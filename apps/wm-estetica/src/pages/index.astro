---
import { appUrl } from "@lib/urls";
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import LiveNow from "../components/ui/LiveNow.astro";
import AntesDespues from "../components/AntesDespues.tsx";
import TratamientoCard from "../components/TratamientoCard.astro";
import ClaseCard from "../components/ClaseCard.astro";
import { estetica, fotos, clips } from "../content/estetica";
import { poster, video } from "@lib/media";

const [tratamientos, clases, equipo, espacio, faq] = estetica.sections;
const destacados = (tratamientos.items ?? []).slice(0, 3);
---

<Base content={estetica}>
  <PageHero hero={estetica.hero} brand={estetica.brand} />

  <!-- 1) La objecion, respondida de entrada. -->
  <section class="wm-container py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div>
        <p class="wm-kicker">La promesa</p>
        <p class="wm-display mt-5 text-[clamp(1.8rem,4.4vw,3rem)] leading-tight">
          {estetica.objeccion}
        </p>
        <p class="mt-6 max-w-xl text-muted">
          En LUMEN no hay fotos retocadas ni promesas imposibles. Antes de
          cualquier tratamiento te decimos qué puede cambiar, cuánto y en
          cuánto tiempo. Y si no te sirve, te lo decimos ahí mismo.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={appUrl("/reservar")} class="wm-btn">Reservar mi turno</a>
          <a href={appUrl("/estetica")} class="wm-btn wm-btn--ghost">Ver los tratamientos</a>
        </div>
        <p class="mt-6 flex items-center gap-3 text-sm text-accent">
          <LiveNow signal={{ label: "Abierto ahora", count: 3, min: 2, max: 5, unit: "turnos libres hoy" }} />
        </p>
        <p class="mt-1 text-xs text-muted">Señal de demostración: los turnos se calculan al azar.</p>
      </div>

      <div class="wm-grade wm-grain wm-vignette overflow-hidden rounded-wm-lg">
        <img
          src={fotos.tratamiento}
          alt="Tratamiento de estética en curso en LUMEN: la estética aplica una máscara sobre el rostro de la clienta (imagen de demostración)."
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- 2) Tratamientos (destacados) -->
  <section class="wm-container py-16 sm:py-20" id="estetica">
    <header class="max-w-2xl">
      <p class="wm-kicker">{tratamientos.kicker}</p>
      <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{tratamientos.title}</h2>
      <p class="mt-5 text-muted">{tratamientos.body}</p>
    </header>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {destacados.map((item, i) => <TratamientoCard item={item} index={i} />)}
    </div>

    <p class="mt-8 text-sm text-muted">
      <a href={appUrl("/estetica")} class="font-semibold text-accent underline underline-offset-4">
        Ver los seis tratamientos con precio y duración
      </a>
    </p>
  </section>

  <!-- 3) Clases por resultado -->
  <section class="wm-container py-16 sm:py-20" id="yoga">
    <header class="max-w-2xl">
      <p class="wm-kicker">{clases.kicker}</p>
      <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{clases.title}</h2>
      <p class="mt-5 text-muted">{clases.body}</p>
    </header>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {clases.items?.map((item, i) => <ClaseCard item={item} index={i} />)}
    </div>

    <p class="mt-8 text-sm text-muted">
      <a href={appUrl("/yoga")} class="font-semibold text-accent underline underline-offset-4">
        Ver los horarios de la semana y el recorrido del estudio
      </a>
    </p>
  </section>

  <!-- 4) SECCIÓN PINNED: el antes y después + el protocolo -->
  <section id="antes-despues" class="relative border-y border-line py-20 sm:py-28">
    <div class="wm-container">
      <div class="grid gap-12 lg:grid-cols-[1fr_1.15fr] lg:gap-16">
        <div>
          <p class="wm-kicker">El protocolo</p>
          <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.4rem)]">
            Una facial, cuatro momentos
          </h2>

          <ol class="mt-10 border-l border-line">
            {
              [
                {
                  t: "Antes de tocarte",
                  d: "Diez minutos de conversación: cómo dormís, qué te molesta, qué probaste. Sin eso, cualquier activo es adivinar.",
                },
                {
                  t: "La limpieza",
                  d: "Vapor, exfoliación enzimática y extracción manual suave. Nada de prisa y nada de dejar la piel tirante.",
                },
                {
                  t: "El activo",
                  d: "Ácido suave en baja concentración y una máscara calmante. El activo que usás depende de lo que vimos en la primera consulta.",
                },
                {
                  t: "El alta",
                  d: "Te damos la rutina para la casa por escrito y cuándo conviene volver. También qué no hacer los dos días siguientes.",
                },
              ].map((p, i) => (
                <li class="relative border-b border-line py-6 pl-8 last:border-b-0">
                  <span
                    aria-hidden="true"
                    class="absolute top-8 -left-[0.42rem] flex h-3 w-3 rounded-full bg-accent"
                  />
                  <p class="text-xs uppercase tracking-[0.24em] text-muted">
                    Paso {String(i + 1).padStart(2, "0")}
                  </p>
                  <h3 class="wm-display mt-2 text-xl leading-tight">{p.t}</h3>
                  <p class="mt-2 max-w-xl text-sm text-muted">{p.d}</p>
                </li>
              ))
            }
          </ol>

          <blockquote class="mt-10 border-l-2 border-accent pl-6">
            <p class="wm-display text-xl leading-snug">
              “No te vamos a retocar las fotos ni a prometerte un antes y después
              imposible. Si algo no lo podemos garantizar, te lo decimos antes de cobrar.”
            </p>
          </blockquote>

          <a href={appUrl("/reservar")} class="wm-btn mt-8">Reservar mi turno</a>
        </div>

        <div class="lg:sticky lg:top-28 lg:self-start">
          <div class="wm-grade wm-grain wm-vignette overflow-hidden rounded-wm-lg">
            <AntesDespues
              client:visible
              src={fotos.piel}
              alt="Retrato de una piel sin maquillaje sobre fondo oscuro, usado como base de la comparativa ilustrativa de LUMEN (imagen de demostración)."
              antes="Antes"
              despues="Después"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5) Banda de video: el producto, sin vueltas -->
  <section class="relative overflow-hidden border-y border-line">
    <div class="wm-grade wm-grain wm-vignette absolute inset-0">
      <video
        class="h-full w-full object-cover"
        src={video(clips.rodillo.id)}
        poster={poster(clips.rodillo.id)}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-label="Rodillo de jade en una rutina de skincare de LUMEN (imagen de demostración)."
      ></video>
    </div>
    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to right, var(--wm-bg) 0%, color-mix(in oklab, var(--wm-bg) 72%, transparent) 58%, transparent 100%)"
    >
    </div>
    <div class="wm-container relative py-24 sm:py-32">
      <p class="wm-kicker">Skincare, dicho claro</p>
      <h2 class="wm-display mt-5 max-w-2xl text-[clamp(2rem,5vw,3.4rem)]">
        Tres pasos, no veinte
      </h2>
      <p class="mt-5 max-w-lg text-muted">
        Limpieza, activo y humectante. Todo lo que usamos está en el
        baño de los gabinetes: lo podés ver, oler y probar antes de comprar.
      </p>
      <a href={appUrl("/estetica")} class="wm-btn mt-8">Ver los tratamientos</a>
    </div>
  </section>

  <!-- 6) Qué usamos -->
  <section class="wm-container py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.05fr] lg:items-center">
      <div class="wm-grade wm-grain wm-vignette order-2 overflow-hidden rounded-wm-lg lg:order-1">
        <img
          src={fotos.insumos}
          alt="Insumos del gabinete de LUMEN: dispenser, toalla, vela y tulipanes sobre una mesa clara (imagen de demostración)."
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
      </div>
      <div class="order-1 lg:order-2">
        <p class="wm-kicker">Los insumos</p>
        <h2 class="wm-display mt-5 text-[clamp(1.8rem,4.5vw,2.8rem)]">
          Nada de marcas que nadie conoce
        </h2>
        <p class="mt-5 text-muted">
          Trabajamos con pocas marcas, las que ya testamos en el estudio y las
          que podemos respaldar. Si algo te sentó mal, lo anotamos en tu ficha
          para no repetírtelo.
        </p>
        <ul class="mt-6 space-y-2 text-muted">
          {
            [
              "Si tenés alergias o piel reactiva, avisanos antes de la primera sesión",
              "Desinfección de cabinas y camillas entre cliente y cliente",
              "Todo el material abierto es de un solo uso y se descarta",
            ].map((p) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class="text-accent">→</span>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 7) El equipo -->
  <section class="wm-container py-16 sm:py-20" id="equipo">
    <header class="max-w-2xl">
      <p class="wm-kicker">{equipo.kicker}</p>
      <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{equipo.title}</h2>
      <p class="mt-5 text-muted">{equipo.body}</p>
    </header>

    <div class="mt-12 grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div class="wm-grade wm-grain wm-vignette overflow-hidden rounded-wm-lg">
        <img
          src={fotos.equipo}
          alt="Retrato de Sol Ferreyra, fundadora de LUMEN (imagen de demostración)."
          loading="lazy"
          decoding="async"
          class="aspect-[4/5] w-full object-cover"
        />
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        {
          equipo.items?.map((item) => (
            <article class="wm-card">
              <h3 class="wm-display text-xl leading-tight">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
              {item.meta?.length ? (
                <p class="mt-4 text-xs uppercase tracking-[0.14em] text-muted">
                  {item.meta.map((m) => `${m.label}: ${m.value}`).join(" · ")}
                </p>
              ) : null}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 8) Horarios y señales en vivo -->
  <section class="border-y border-line">
    <div class="wm-container grid gap-10 py-16 sm:py-20 lg:grid-cols-3">
      <div>
        <p class="wm-kicker">Horarios</p>
        <h2 class="wm-display mt-5 text-[clamp(1.8rem,4.5vw,2.6rem)]">
          Abrimos cuando podés
        </h2>
        <p class="mt-4 text-muted">{estetica.contact.hours}</p>
      </div>

      <div class="wm-card">
        <p class="wm-kicker">En vivo</p>
        <p class="mt-4 text-sm text-accent">
          <LiveNow signal={{ label: "Abierto ahora", count: 3, min: 2, max: 5, unit: "turnos libres hoy" }} />
        </p>
        <p class="mt-4 text-sm text-accent">
          <LiveNow signal={{ label: "Quedan lugares en el turno de las 18:00", count: 1, min: 1, max: 2, unit: "lugares" }} />
        </p>
        <p class="mt-4 text-sm text-accent">
          <LiveNow signal={{ label: "Próxima clase 19:15 · lugares", count: 5, min: 3, max: 7, unit: "libres" }} />
        </p>
        <p class="mt-4 text-xs text-muted">
          Señales de demostración: los números fluctúan al azar y no salen de un
          sistema real de agenda.
        </p>
      </div>

      <div class="wm-card">
        <p class="wm-kicker">El espacio</p>
        <p class="mt-4 text-sm leading-relaxed text-muted">{espacio.body}</p>
        <a href={appUrl("/yoga")} class="mt-5 inline-block text-sm font-semibold text-accent underline underline-offset-4">
          Ver el recorrido del estudio
        </a>
      </div>
    </div>
  </section>

  <!-- 9) FAQ -->
  <section class="wm-container py-16 sm:py-20" id="faq">
    <header class="max-w-2xl">
      <p class="wm-kicker">{faq.kicker}</p>
      <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{faq.title}</h2>
    </header>

    <div class="mt-12 divide-y divide-line border-y border-line">
      {
        (faq.items ?? []).slice(0, 5).map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6">
              <span class="wm-display text-xl leading-snug">{item.title}</span>
              <span aria-hidden="true" class="text-2xl text-accent transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="mt-4 max-w-3xl text-muted">{item.body}</p>
          </details>
        ))
      }
    </div>

    <p class="mt-8 text-sm text-muted">
      <a href={appUrl("/contacto")} class="font-semibold text-accent underline underline-offset-4">
        Ver las preguntas completas y escribirnos
      </a>
    </p>
  </section>

  <!-- 10) Cierre -->
  <section class="wm-container pb-24">
    <div class="rounded-wm-lg border border-line p-8 sm:p-14">
      <p class="wm-kicker">Último paso</p>
      <h2 class="wm-display mt-5 max-w-2xl text-[clamp(1.8rem,4.5vw,2.8rem)]">
        Elegí el turno y te llevás el pase
      </h2>
      <p class="mt-4 max-w-xl text-muted">
        Cuatro pasos: qué querés, el horario, tus datos y la seña. Sin registro
        ni usuario, sin letra chica.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href={appUrl("/reservar")} class="wm-btn">Reservar mi turno</a>
        <a href={appUrl("/contacto")} class="wm-btn wm-btn--ghost">Escribir por WhatsApp</a>
      </div>
    </div>
  </section>
</Base>

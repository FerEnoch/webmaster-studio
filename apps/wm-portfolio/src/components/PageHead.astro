---
/**
 * Cabecera de paginas internas: kicker + titular + bajada.
 * (Mismo patron que el resto de las apps del kit.)
 */
export interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
}

const { kicker, title, subtitle } = Astro.props;
---

<header class="wm-container pt-36 pb-12 sm:pt-44 sm:pb-16">
  <p class="wm-kicker">{kicker}</p>
  <h1 class="wm-display mt-6 text-[clamp(2.4rem,8vw,5.5rem)]">{title}</h1>
  {subtitle ? <p class="mt-6 max-w-2xl text-lg text-muted">{subtitle}</p> : null}
</header>

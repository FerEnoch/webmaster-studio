---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import DemoRequest from "../components/DemoRequest.tsx";
import { portfolio } from "../content/portfolio";
---

<Base content={portfolio} title={`Contacto · ${portfolio.brand}`}>
  <PageHead kicker="Contacto" title="Contacto y cotización" />

  <section class="wm-container pb-20 sm:pb-28">
    <DemoRequest
      client:load
      brand={portfolio.brand}
      title={portfolio.conversion.title}
      kicker={portfolio.conversion.kicker}
      body={portfolio.conversion.body}
      options={portfolio.conversion.options}
      demoNotice={portfolio.conversion.demoNotice}
      studioWhatsapp={portfolio.contact.whatsapp}
    />

    <div class="mt-8 rounded-wm-lg border border-line p-8">
      <p class="wm-kicker">Datos de contacto ilustrativos</p>
      <dl class="mt-6 grid gap-4 text-muted sm:grid-cols-2">
        <div>
          <dt class="text-xs uppercase tracking-[0.14em]">Teléfono</dt>
          <dd class="mt-1 text-lg text-fg">{portfolio.contact.phone}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.14em]">Email</dt>
          <dd class="mt-1 text-lg text-fg">
            <a href={`mailto:${portfolio.contact.email}`} class="hover:text-accent">
              {portfolio.contact.email}
            </a>
          </dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.14em]">Horarios</dt>
          <dd class="mt-1 text-lg text-fg">{portfolio.contact.hours}</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-[0.14em]">Zona</dt>
          <dd class="mt-1 text-lg text-fg">{portfolio.contact.address}</dd>
        </div>
      </dl>
      <p class="mt-6 text-sm text-muted">
        Los datos publicados son ficticios y no constituyen un canal operativo de atención.
      </p>
    </div>
  </section>
</Base>

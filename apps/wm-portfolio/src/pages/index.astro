---
import Base from "../layouts/Base.astro";
import PageHero from "../components/ui/PageHero.astro";
import PinnedStory from "../components/PinnedStory.astro";
import PlanCard from "../components/PlanCard.astro";
import DemoIndex from "../components/DemoIndex.astro";
import DemoRequest from "../components/DemoRequest.tsx";
import LazyVideo from "../components/LazyVideo.astro";
import { portfolio, fotoEstudio } from "../content/portfolio";
import { poster, video } from "@lib/media";

const servicios = portfolio.sections.find((s) => s.id === "servicios")!;
const precios = portfolio.sections.find((s) => s.id === "precios")!;
const proceso = portfolio.sections.find((s) => s.id === "proceso")!;
const prueba = portfolio.sections.find((s) => s.id === "prueba")!;
const faq = portfolio.sections.find((s) => s.id === "faq")!;
---

<Base content={portfolio}>
  <PageHero hero={portfolio.hero} brand={portfolio.brand} />

  <!-- 1) La objecion, respondida de entrada. -->
  <section class="wm-container py-16 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.1fr] lg:items-center">
      <div>
        <p class="wm-kicker">El problema</p>
        <p class="wm-display mt-5 text-[clamp(1.8rem,4.4vw,3rem)] leading-tight">
          {portfolio.objeccion}
        </p>
        <p class="mt-6 max-w-xl text-muted">
          La respuesta corta: no son templates. Cada demo de este portfolio
          responde una objeción concreta de su rubro —la sala de espera, la
          letra chica, la pintura rayada— con una conversión que termina en un
          ticket. Abrilas, probalas y decime si te cierra.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href="/demos" class="wm-btn">Ver las 7 demos</a>
          <a href="#demo" class="wm-btn wm-btn--ghost">Pedir la mia gratis</a>
        </div>
      </div>

      <div class="wm-grade wm-grain wm-vignette overflow-hidden rounded-wm-lg">
        <img
          src={fotoEstudio}
          alt="Mesa de trabajo de un estudio web con pantallas y planos (imagen de demostración)."
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full object-cover"
        />
      </div>
    </div>
  </section>

  <!-- 2) Banda de video: el proceso. -->
  <section class="relative overflow-hidden border-y border-line">
    <div class="wm-grade wm-grain wm-vignette absolute inset-0">
      <LazyVideo
        src={video(3091)}
        poster={poster(3091)}
        alt="Plano de una obra en marcha (imagen de demostración)."
      />
    </div>
    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to right, var(--wm-bg) 0%, color-mix(in oklab, var(--wm-bg) 72%, transparent) 58%, transparent 100%)"
    >
    </div>
    <div class="wm-container relative py-24 sm:py-32">
      <p class="wm-kicker">48 horas</p>
      <h2 class="wm-display mt-5 max-w-2xl text-[clamp(2rem,5vw,3.4rem)]">
        De la objeción al ticket, sin reunión
      </h2>
      <p class="mt-5 max-w-lg text-muted">
        Me contás el negocio, te armo una home con tu contenido y te la mando
        con un código. Si te sirve, seguimos; si no, no perdiste nada.
      </p>
      <a href="#demo" class="wm-btn mt-8">Pedir mi demo gratis</a>
    </div>
  </section>

  <!-- 3) Seccion "pinned": el proceso de 48 h. -->
  <PinnedStory
    items={proceso.items ?? []}
    kicker={proceso.kicker}
    title="De la objeción al ticket en 48 horas"
    body={proceso.body}
  />

  <!-- 4) El indice de las 7 demos. -->
  <section class="wm-container py-16 sm:py-20" id="demos">
    <header class="max-w-2xl">
      <p class="wm-kicker">Las 7 demos</p>
      <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">
        Siete rubros, siete webs que ya funcionan
      </h2>
      <p class="mt-5 text-muted">
        Cada una tiene su propia identidad visual —por eso cada card lleva el
        color de su rubro— pero todas comparten la misma firma: cortina entre
        rutas, hero de video que se encoge, grano, un ticket y un solo CTA.
      </p>
    </header>

    <div class="mt-12">
      <DemoIndex />
    </div>

    <p class="mt-8 text-sm text-muted">
      <a href="/demos" class="font-semibold text-accent underline underline-offset-4">
        Filtrar las demos por rubro
      </a>
    </p>
  </section>

  <!-- 5) Banda de video: una demo entre las siete. -->
  <section class="relative overflow-hidden border-y border-line">
    <div class="wm-grade wm-grain wm-vignette absolute inset-0">
      <LazyVideo
        src={video(4219)}
        poster={poster(4219)}
        alt="Consulta de pediatría dentro de una de las demos (imagen de demostración)."
      />
    </div>
    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to right, var(--wm-bg) 0%, color-mix(in oklab, var(--wm-bg) 70%, transparent) 55%, transparent 100%)"
    >
    </div>
    <div class="wm-container relative py-24 sm:py-32">
      <p class="wm-kicker">Demos vivas</p>
      <h2 class="wm-display mt-5 max-w-2xl text-[clamp(2rem,5vw,3.4rem)]">
        No son capturas: son webs que se recorren
      </h2>
      <p class="mt-5 max-w-lg text-muted">
        En cada demo podés pedir un turno, reservar un lavado, cotizar una obra
        o sacar un pase. La conversión es real dentro de la demo: es lo que
        después va en tu web.
      </p>
      <a href="/demos" class="wm-btn mt-8">Abrir el portfolio filtrable</a>
    </div>
  </section>

  <!-- 6) Servicios. -->
  <section class="wm-container py-16 sm:py-20" id="servicios">
    <header class="max-w-2xl">
      <p class="wm-kicker">{servicios.kicker}</p>
      <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{servicios.title}</h2>
      <p class="mt-5 text-muted">{servicios.body}</p>
    </header>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {servicios.items?.map((item, i) => <PlanCard item={item} index={i} />)}
    </div>

    <div class="mt-12 rounded-wm-lg border border-line p-8 sm:p-10">
      <p class="wm-kicker">Precios</p>
      <h3 class="wm-display mt-4 text-[clamp(1.6rem,4vw,2.6rem)]">
        Los precios, antes de la llamada
      </h3>
      <dl class="mt-8 divide-y divide-line border-y border-line">
        {
          precios.items?.map((item) => (
            <div class="flex flex-wrap items-baseline justify-between gap-4 py-4">
              <dt class="font-semibold">{item.title}</dt>
              <dd class="wm-display text-xl text-accent">{item.price?.amount}</dd>
              <dd class="w-full text-xs text-muted sm:w-auto">{item.price?.note}</dd>
            </div>
          ))
        }
      </dl>
      <a href="/servicios" class="wm-btn mt-8">Ver el detalle de los servicios</a>
    </div>
  </section>

  <!-- 7) Prueba honesta. -->
  <section class="wm-container py-16 sm:py-20" id="prueba">
    <header class="max-w-2xl">
      <p class="wm-kicker">{prueba.kicker}</p>
      <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{prueba.title}</h2>
      <p class="mt-5 text-muted">{prueba.body}</p>
    </header>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {prueba.items?.map((item, i) => <PlanCard item={item} index={i} />)}
    </div>

    <p class="mt-8 text-sm text-muted">
      Demo de portfolio: no hay clientes reales, no hay logos y no hay
      testimonios. Lo de arriba es el estándar con el que trabajo y lo que se
      puede verificar de mi propio trabajo.
    </p>
  </section>

  <!-- 8) Banda de video: la prueba. -->
  <section class="relative overflow-hidden border-y border-line">
    <div class="wm-grade wm-grain wm-vignette absolute inset-0">
      <LazyVideo
        src={video(3093)}
        poster={poster(3093)}
        alt="Detalle de una maqueta en construcción (imagen de demostración)."
      />
    </div>
    <div
      class="pointer-events-none absolute inset-0"
      style="background: linear-gradient(to right, var(--wm-bg) 0%, color-mix(in oklab, var(--wm-bg) 70%, transparent) 55%, transparent 100%)"
    >
    </div>
    <div class="wm-container relative py-24 sm:py-32">
      <p class="wm-kicker">Sin clientes</p>
      <h2 class="wm-display mt-5 max-w-2xl text-[clamp(2rem,5vw,3.4rem)]">
        No hay logos de clientes en esta pagina
      </h2>
      <p class="mt-5 max-w-lg text-muted">
        Escribo "portfolio" y hablo de proceso, no de resultados ajenos. Cuando
        tenga clientes reales, van a estar acá, con nombre y permiso.
      </p>
      <a href="#demo" class="wm-btn mt-8">Pedir mi demo gratis</a>
    </div>
  </section>

  <!-- 9) Conversion principal: 4 pasos hasta el ticket. -->
  <section id="demo" class="wm-container relative py-20 sm:py-28">
    <div class="max-w-2xl">
      <p class="wm-kicker">{portfolio.conversion.kicker}</p>
      <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">
        {portfolio.conversion.title}
      </h2>
      <p class="mt-5 text-muted">{portfolio.conversion.body}</p>
    </div>

    <ol class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        portfolio.conversion.steps.map((step, i) => (
          <li class="rounded-wm border border-line p-5">
            <span class="wm-display text-3xl text-accent">
              {String(i + 1).padStart(2, "0")}
            </span>
            <p class="mt-2 font-semibold">{step}</p>
            <p class="mt-1 text-sm text-muted">
              {i === 0 && "Elegis el rubro de tu negocio."}
              {i === 1 && "Me decís cómo es tu negocio."}
              {i === 2 && "Dejás un teléfono o un email."}
              {i === 3 && "Recibís el ticket con el código de la demo."}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12">
      <DemoRequest
        client:load
        brand={portfolio.brand}
        title={portfolio.conversion.title}
        kicker={portfolio.conversion.kicker}
        body={portfolio.conversion.body}
        steps={portfolio.conversion.steps}
        options={portfolio.conversion.options}
        slots={portfolio.conversion.slots}
        demoNotice={portfolio.conversion.demoNotice}
        studioWhatsapp={portfolio.contact.whatsapp}
        priceNote="USD 0 · demo gratis"
      />
    </div>
  </section>

  <!-- 10) FAQ. -->
  <section class="wm-container py-16 sm:py-20" id="faq">
    <header class="max-w-2xl">
      <p class="wm-kicker">{faq.kicker}</p>
      <h2 class="wm-display mt-5 text-[clamp(2rem,5vw,3.6rem)]">{faq.title}</h2>
    </header>

    <div class="mt-12 divide-y divide-line border-y border-line">
      {
        faq.items?.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6">
              <span class="wm-display text-xl leading-snug">{item.title}</span>
              <span
                aria-hidden="true"
                class="text-2xl text-accent transition-transform group-open:rotate-45"
              >
                +
              </span>
            </summary>
            <p class="mt-4 max-w-3xl text-muted">{item.body}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- 11) Cierre. -->
  <section class="wm-container pb-20 sm:pb-28">
    <div class="rounded-wm-lg border border-line p-8 sm:p-12">
      <p class="wm-kicker">El paso que falta</p>
      <h2 class="wm-display mt-4 text-[clamp(1.8rem,4.5vw,2.8rem)]">
        Mandame tu rubro y te armo la demo
      </h2>
      <p class="mt-4 max-w-xl text-muted">
        Si preferis hablar, escribinos por WhatsApp: te respondo en el día con
        las preguntas justas para arrancar.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#demo" class="wm-btn">Pedir mi demo gratis</a>
        <a href="/contacto" class="wm-btn wm-btn--ghost">Ver contacto</a>
      </div>
    </div>
  </section>
</Base>

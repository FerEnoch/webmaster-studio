---
// Arte original de TELAR: siluetas de prendas dibujadas en SVG local.
// Nada externo: fondo papel con trama de telar + prenda en el color
// de la variante. `motivo` define la silueta, `color` el relleno.
export interface Props {
  motivo: "remera" | "camisa" | "pantalon" | "vestido" | "campera" | "sweater" | "pollera";
  color: string;
  label: string;
}
const { motivo, color, label } = Astro.props;
const gid = `t${Math.abs([...label].reduce((a, c) => a + c.charCodeAt(0), 0)) % 997}`;
---

<svg viewBox="0 0 400 500" role="img" aria-label={label} class="wm-art">
  <defs>
    <pattern id={gid} width="14" height="14" patternUnits="userSpaceOnUse">
      <path d="M0 7H14M7 0V14" stroke="rgba(30,27,22,.10)" stroke-width="1" />
    </pattern>
  </defs>
  <rect width="400" height="500" fill="#F1E9D8" />
  <rect width="400" height="500" fill={`url(#${gid})`} />
  <rect x="24" y="24" width="352" height="452" fill="none" stroke="rgba(30,27,22,.35)" stroke-width="2" />
  <ellipse cx="200" cy="452" rx="110" ry="12" fill="rgba(30,27,22,.12)" />
  {motivo === "remera" && (
    <g>
      <path d="M140 110 L90 150 L115 200 L140 185 L140 400 L260 400 L260 185 L285 200 L310 150 L260 110 Q200 140 140 110Z" fill={color} stroke="rgba(30,27,22,.6)" stroke-width="3" />
      <path d="M140 110 Q200 140 260 110 Q200 128 140 110Z" fill="rgba(30,27,22,.25)" />
    </g>
  )}
  {motivo === "camisa" && (
    <g>
      <path d="M145 105 L100 140 L122 190 L145 178 L145 400 L255 400 L255 178 L278 190 L300 140 L255 105 L200 130Z" fill={color} stroke="rgba(30,27,22,.6)" stroke-width="3" />
      <path d="M200 130 L200 400" stroke="rgba(30,27,22,.5)" stroke-width="3" />
      <circle cx="200" cy="180" r="5" fill="rgba(30,27,22,.6)" />
      <circle cx="200" cy="240" r="5" fill="rgba(30,27,22,.6)" />
      <circle cx="200" cy="300" r="5" fill="rgba(30,27,22,.6)" />
      <path d="M145 105 L200 130 L175 95Z M255 105 L200 130 L225 95Z" fill="rgba(30,27,22,.25)" />
    </g>
  )}
  {motivo === "pantalon" && (
    <g>
      <path d="M140 90 L260 90 L270 400 L215 400 L200 180 L185 400 L130 400Z" fill={color} stroke="rgba(30,27,22,.6)" stroke-width="3" />
      <rect x="140" y="90" width="120" height="22" fill="rgba(30,27,22,.25)" />
    </g>
  )}
  {motivo === "vestido" && (
    <g>
      <path d="M165 80 L235 80 L250 200 L300 400 L100 400 L150 200Z" fill={color} stroke="rgba(30,27,22,.6)" stroke-width="3" />
      <path d="M165 80 Q200 110 235 80" fill="none" stroke="rgba(30,27,22,.6)" stroke-width="3" />
      <path d="M150 200 L250 200" stroke="rgba(30,27,22,.4)" stroke-width="3" />
    </g>
  )}
  {motivo === "campera" && (
    <g>
      <path d="M135 120 L85 160 L110 215 L135 200 L135 400 L265 400 L265 200 L290 215 L315 160 L265 120 L200 150Z" fill={color} stroke="rgba(30,27,22,.6)" stroke-width="3" />
      <path d="M200 150 L200 400" stroke="rgba(30,27,22,.6)" stroke-width="4" />
      <rect x="145" y="250" width="40" height="50" fill="rgba(30,27,22,.2)" />
      <rect x="215" y="250" width="40" height="50" fill="rgba(30,27,22,.2)" />
    </g>
  )}
  {motivo === "pollera" && (
    <g fill={color} stroke="#645143" stroke-width="3">
      <path d="M150 95H250L271 385H129Z" />
      <path d="M150 119H250 M200 385V333" fill="none" />
    </g>
  )}
  {motivo === "sweater" && (
    <g>
      <path d="M140 115 L95 155 L118 205 L142 190 L142 395 L258 395 L258 190 L282 205 L305 155 L260 115 Q200 145 140 115Z" fill={color} stroke="rgba(30,27,22,.6)" stroke-width="3" />
      <path d="M142 360 L258 360 M142 340 L258 340" stroke="rgba(30,27,22,.35)" stroke-width="3" />
      <path d="M170 145 L230 145 L220 230 L180 230Z" fill="rgba(30,27,22,.18)" />
    </g>
  )}
</svg>

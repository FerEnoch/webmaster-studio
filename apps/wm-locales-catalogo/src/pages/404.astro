---
import { appUrl } from "@lib/urls";
const integrated = import.meta.env.BASE_URL.startsWith("/demos/");
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Página no encontrada</title>
    <link rel="icon" href={appUrl("/favicon.svg")} type="image/svg+xml" />
    <style>body{font-family:system-ui,sans-serif;background:#faf6ee;color:#1e1b16;display:grid;place-items:center;min-height:100vh;margin:0}main{text-align:center;padding:2rem}a{color:#7a3518;font-weight:700}</style>
  </head>
  <body><main>
    <h1>No encontramos esa página</h1>
    <p><a href={appUrl("/catalogo")}>Volver al catálogo</a></p>
    {integrated && <p><a href="/" data-astro-reload>Ir a Webmaster Studio <span aria-hidden="true">↗</span></a></p>}
  </main></body>
</html>

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["./*"]
    },
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["types.ts", "rubros.ts", "whatsapp.ts", "media.ts", "components/**/*"]
}

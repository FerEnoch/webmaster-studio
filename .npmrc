# ─── LOCKFILE ESTRICTO ─────────────────────────────────────────────
# Si el lockfile no satisface package.json, la instalación falla.
prefer-frozen-lockfile=true

# ─── PEER DEPENDENCIES ─────────────────────────────────────────────
strict-peer-dependencies=true
auto-install-peers=false

# ─── ENGINE ────────────────────────────────────────────────────────
engine-strict=true

# ─── BUILD SCRIPTS ─────────────────────────────────────────────────
# El `~/.npmrc` del usuario tiene `ignore-scripts=true`.
# En pnpm <= 10 ese flag desactiva en SILENCIO toda la política de build
# scripts (ni strictDepBuilds ni allowBuilds tienen efecto: el install
# sale 0 y los scripts aprobados nunca se ejecutan), por eso se fuerza
# `false` acá a nivel proyecto.
# En pnpm >= 11 el flag `ignore-scripts` ya no existe: la política la
# gobiernan exclusivamente `allowBuilds` + `strictDepBuilds` de
# pnpm-workspace.yaml. Esta línea queda como red de seguridad para
# pnpm 10 y como documentación de la intención.
ignore-scripts=false
